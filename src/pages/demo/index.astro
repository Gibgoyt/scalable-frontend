---
import Layout from 'src/layouts/Layout.astro';
---

<Layout title="Tailwind v4 Demo">
  <main class="container mx-auto p-8">
    <h1 class="text-4xl font-bold mb-8 text-center">Tailwind v4 Custom Colors Demo</h1>
    
    <!-- Custom Color: Ooga -->
    <section class="mb-12">
      <h2 class="text-2xl font-semibold mb-6">Custom Color: Ooga</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <div class="bg-ooga text-white p-6 rounded-lg shadow-lg">
          <h3 class="text-xl font-bold mb-2">Background Ooga</h3>
          <p>Using bg-ooga class</p>
        </div>
        <div class="border-4 border-ooga p-6 rounded-lg">
          <h3 class="text-xl font-bold mb-2 text-ooga">Text & Border Ooga</h3>
          <p>Using text-ooga and border-ooga classes</p>
        </div>
        <div class="bg-gradient-to-r from-ooga to-booga-500 text-white p-6 rounded-lg shadow-lg">
          <h3 class="text-xl font-bold mb-2">Gradient with Ooga</h3>
          <p>Gradient from ooga to booga-500</p>
        </div>
      </div>
    </section>

    <!-- Custom Color Palette: Booga -->
    <section class="mb-12">
      <h2 class="text-2xl font-semibold mb-6">Custom Color Palette: Booga (100-900)</h2>
      <div class="grid grid-cols-1 sm:grid-cols-3 lg:grid-cols-5 gap-4">
        <div class="bg-booga-100 p-4 rounded-lg text-center">
          <p class="font-semibold text-booga-900">Booga 100</p>
          <p class="text-sm text-booga-800">bg-booga-100</p>
        </div>
        <div class="bg-booga-200 p-4 rounded-lg text-center">
          <p class="font-semibold text-booga-900">Booga 200</p>
          <p class="text-sm text-booga-800">bg-booga-200</p>
        </div>
        <div class="bg-booga-300 p-4 rounded-lg text-center">
          <p class="font-semibold text-booga-900">Booga 300</p>
          <p class="text-sm text-booga-800">bg-booga-300</p>
        </div>
        <div class="bg-booga-400 p-4 rounded-lg text-center">
          <p class="font-semibold text-white">Booga 400</p>
          <p class="text-sm text-booga-100">bg-booga-400</p>
        </div>
        <div class="bg-booga-500 p-4 rounded-lg text-center">
          <p class="font-semibold text-white">Booga 500</p>
          <p class="text-sm text-booga-100">bg-booga-500</p>
        </div>
        <div class="bg-booga-600 p-4 rounded-lg text-center">
          <p class="font-semibold text-white">Booga 600</p>
          <p class="text-sm text-booga-100">bg-booga-600</p>
        </div>
        <div class="bg-booga-700 p-4 rounded-lg text-center">
          <p class="font-semibold text-white">Booga 700</p>
          <p class="text-sm text-booga-100">bg-booga-700</p>
        </div>
        <div class="bg-booga-800 p-4 rounded-lg text-center">
          <p class="font-semibold text-white">Booga 800</p>
          <p class="text-sm text-booga-100">bg-booga-800</p>
        </div>
        <div class="bg-booga-900 p-4 rounded-lg text-center">
          <p class="font-semibold text-white">Booga 900</p>
          <p class="text-sm text-booga-100">bg-booga-900</p>
        </div>
      </div>
    </section>

    <!-- Cool Tailwind Features -->
    <section class="mb-12">
      <h2 class="text-2xl font-semibold mb-6">Cool Tailwind v4 Features</h2>
      
      <!-- Animations -->
      <div class="mb-8">
        <h3 class="text-xl font-semibold mb-4">Animations & Transitions</h3>
        <div class="flex flex-wrap gap-4">
          <button class="bg-ooga hover:bg-booga-600 text-white px-6 py-3 rounded-lg transition-colors duration-300 transform hover:scale-105">
            Hover Me!
          </button>
          <div class="bg-booga-500 text-white p-4 rounded-lg animate-pulse">
            Pulsing Element
          </div>
          <div class="bg-gradient-to-r from-ooga to-booga-500 text-white p-4 rounded-lg animate-bounce">
            Bouncing Element
          </div>
        </div>
      </div>

      <!-- Grid & Flexbox -->
      <div class="mb-8">
        <h3 class="text-xl font-semibold mb-4">Advanced Layouts</h3>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-4">
          <div class="bg-booga-200 p-4 rounded-lg col-span-2">Col Span 2</div>
          <div class="bg-booga-300 p-4 rounded-lg">Normal</div>
          <div class="bg-booga-400 text-white p-4 rounded-lg">Normal</div>
        </div>
        <div class="flex gap-4 flex-wrap">
          <div class="flex-1 min-w-[200px] bg-ooga text-white p-4 rounded-lg">Flex 1</div>
          <div class="flex-2 min-w-[200px] bg-booga-600 text-white p-4 rounded-lg">Flex 2</div>
          <div class="flex-1 min-w-[200px] bg-booga-800 text-white p-4 rounded-lg">Flex 1</div>
        </div>
      </div>

      <!-- Shadows & Effects -->
      <div class="mb-8">
        <h3 class="text-xl font-semibold mb-4">Shadows & Effects</h3>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <div class="bg-white dark:bg-gray-800 p-6 rounded-lg shadow-lg shadow-ooga/50">
            <h4 class="font-semibold mb-2">Colored Shadow</h4>
            <p class="text-sm text-gray-600 dark:text-gray-400">Using shadow-ooga/50</p>
          </div>
          <div class="bg-gradient-to-br from-booga-400 to-booga-700 text-white p-6 rounded-lg backdrop-blur-sm">
            <h4 class="font-semibold mb-2">Gradient Background</h4>
            <p class="text-sm">With backdrop blur</p>
          </div>
          <div class="border-2 border-dashed border-ooga p-6 rounded-lg hover:border-solid transition-all">
            <h4 class="font-semibold mb-2">Dashed Border</h4>
            <p class="text-sm text-gray-600 dark:text-gray-400">Hover for solid border</p>
          </div>
        </div>
      </div>

      <!-- Typography -->
      <div class="mb-8">
        <h3 class="text-xl font-semibold mb-4">Typography Showcase</h3>
        <div class="space-y-4">
          <p class="text-xs text-booga-400">Extra Small Text (text-xs)</p>
          <p class="text-sm text-booga-500">Small Text (text-sm)</p>
          <p class="text-base text-booga-600">Base Text (text-base)</p>
          <p class="text-lg text-booga-700">Large Text (text-lg)</p>
          <p class="text-xl text-booga-800">Extra Large Text (text-xl)</p>
          <p class="text-2xl font-light text-ooga">2XL Light Text</p>
          <p class="text-3xl font-medium bg-gradient-to-r from-ooga to-booga-600 bg-clip-text text-transparent">
            3XL Gradient Text
          </p>
        </div>
      </div>

      <!-- Forms -->
      <div class="mb-8">
        <h3 class="text-xl font-semibold mb-4">Form Elements</h3>
        <form class="space-y-4 max-w-md">
          <input 
            type="text" 
            placeholder="Custom styled input" 
            class="w-full px-4 py-2 bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100 border-2 border-booga-300 dark:border-booga-600 rounded-lg focus:border-ooga focus:outline-none focus:ring-2 focus:ring-ooga/20 transition-all placeholder-gray-500 dark:placeholder-gray-400"
          />
          <select class="w-full px-4 py-2 bg-booga-100 dark:bg-gray-800 text-gray-900 dark:text-gray-100 border-2 border-booga-300 dark:border-booga-600 rounded-lg focus:border-booga-500 focus:outline-none">
            <option>Select an option</option>
            <option>Option 1</option>
            <option>Option 2</option>
          </select>
          <div class="flex items-center space-x-2">
            <input type="checkbox" id="check" class="w-4 h-4 text-ooga rounded focus:ring-ooga accent-ooga" />
            <label for="check" class="text-sm text-gray-700 dark:text-gray-300">Custom checkbox with ooga accent</label>
          </div>
          <button type="submit" class="w-full bg-gradient-to-r from-ooga to-booga-600 text-white py-2 px-4 rounded-lg hover:from-booga-600 hover:to-ooga transition-all duration-300 transform hover:scale-[1.02]">
            Submit Form
          </button>
        </form>
      </div>

      <!-- Cards with Hover Effects -->
      <div class="mb-8">
        <h3 class="text-xl font-semibold mb-4">Interactive Cards</h3>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <div class="group relative overflow-hidden rounded-lg shadow-lg hover:shadow-xl transition-shadow duration-300">
            <div class="absolute inset-0 bg-gradient-to-r from-ooga to-booga-500 opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
            <div class="relative bg-white dark:bg-gray-800 p-6 group-hover:text-white transition-colors duration-300">
              <h4 class="font-semibold mb-2">Hover Reveal Card</h4>
              <p class="text-sm">Hover to see gradient overlay</p>
            </div>
          </div>
          <div class="bg-booga-100 p-6 rounded-lg hover:bg-booga-200 transition-colors duration-300 cursor-pointer transform hover:-translate-y-1">
            <h4 class="font-semibold mb-2 text-booga-900">Lift on Hover</h4>
            <p class="text-sm text-booga-700">This card lifts up on hover</p>
          </div>
          <div class="relative p-6 rounded-lg border-2 border-transparent hover:border-ooga bg-gradient-to-r from-booga-100 to-booga-200 transition-all duration-300">
            <h4 class="font-semibold mb-2">Border Animation</h4>
            <p class="text-sm">Border appears on hover</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Dark Mode Demo -->
    <section class="mb-12">
      <h2 class="text-2xl font-semibold mb-6">Dark Mode Support</h2>
      <div class="bg-gray-100 dark:bg-gray-800 p-6 rounded-lg">
        <p class="text-gray-900 dark:text-gray-100 mb-4">
          This section adapts to dark mode! The custom colors work seamlessly with Tailwind's dark mode utilities.
        </p>
        <div class="flex flex-wrap gap-4">
          <div class="bg-ooga dark:bg-booga-700 text-white p-4 rounded">
            Changes in dark mode
          </div>
          <div class="bg-booga-200 dark:bg-booga-800 text-booga-900 dark:text-booga-100 p-4 rounded">
            Adaptive colors
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>