---
import Layout from 'src/layouts/Layout.astro';
---

<Layout title="Applications - ASSQ-CloudFlare Stack">

	<main>

		<!-- Hero Section -->
		<section class="bg-gradient-to-b from-blue-50 to-white dark:from-gray-900 dark:to-gray-800 py-16 lg:py-24">
			<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
				<div class="text-center">
					<h1 class="text-4xl lg:text-5xl font-bold mb-6">
						Framework Applications Hub
					</h1>
					<p class="text-xl text-gray-600 dark:text-gray-300 max-w-3xl mx-auto">
						Explore different application architectures and patterns using Astro, SolidJS, and Svelte. Learn about client islands, server islands, SPAs, and hydration strategies.
					</p>
				</div>
			</div>
		</section>

		<!-- Application Types Section -->
		<section class="py-16 lg:py-24">
			<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
				<h2 class="text-3xl font-bold text-center mb-12">Application Architectures</h2>
				
				<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 mb-16">
					<!-- SPA Applications -->
					<div class="bg-white dark:bg-gray-800 rounded-xl shadow-lg p-8">
						<div class="w-12 h-12 bg-blue-100 dark:bg-blue-900 rounded-lg flex items-center justify-center mb-4">
							<svg class="w-6 h-6 text-blue-600 dark:text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
							</svg>
						</div>
						<h3 class="text-xl font-semibold mb-3">Single Page Applications</h3>
						<p class="text-gray-600 dark:text-gray-300 mb-4">
							Full client-side applications with routing, state management, and complete framework hydration.
						</p>
						<div class="space-y-2">
							<a href="/solid-spa" class="block px-4 py-2 bg-purple-100 dark:bg-purple-900/20 text-purple-700 dark:text-purple-300 rounded-lg hover:bg-purple-200 dark:hover:bg-purple-900/40 transition-colors">
								🔥 SolidJS SPA
							</a>
							<a href="/svelte-spa" class="block px-4 py-2 bg-orange-100 dark:bg-orange-900/20 text-orange-700 dark:text-orange-300 rounded-lg hover:bg-orange-200 dark:hover:bg-orange-900/40 transition-colors">
								🎯 Svelte SPA
							</a>
							<a href="/qwik-spa" class="block px-4 py-2 bg-orange-100 dark:bg-orange-900/20 text-orange-700 dark:text-orange-300 rounded-lg hover:bg-orange-200 dark:hover:bg-orange-900/40 transition-colors">
								👄 Qwik SPA
							</a>
						</div>
					</div>

					<!-- Client Islands -->
					<div class="bg-white dark:bg-gray-800 rounded-xl shadow-lg p-8">
						<div class="w-12 h-12 bg-green-100 dark:bg-green-900 rounded-lg flex items-center justify-center mb-4">
							<svg class="w-6 h-6 text-green-600 dark:text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path>
							</svg>
						</div>
						<h3 class="text-xl font-semibold mb-3">Client Islands</h3>
						<p class="text-gray-600 dark:text-gray-300 mb-4">
							Interactive components hydrated only when needed, keeping the majority of the page static.
						</p>
						<div class="space-y-2">
							<a href="/islands/interactive" class="block px-4 py-2 bg-green-100 dark:bg-green-900/20 text-green-700 dark:text-green-300 rounded-lg hover:bg-green-200 dark:hover:bg-green-900/40 transition-colors">
								🏝️ Interactive Islands
							</a>
							<a href="/islands/lazy" class="block px-4 py-2 bg-teal-100 dark:bg-teal-900/20 text-teal-700 dark:text-teal-300 rounded-lg hover:bg-teal-200 dark:hover:bg-teal-900/40 transition-colors">
								⏰ Lazy Load Islands
							</a>
							<a href="/islands/visible" class="block px-4 py-2 bg-cyan-100 dark:bg-cyan-900/20 text-cyan-700 dark:text-cyan-300 rounded-lg hover:bg-cyan-200 dark:hover:bg-cyan-900/40 transition-colors">
								👁️ Visible Islands
							</a>
						</div>
					</div>

					<!-- Server Islands -->
					<div class="bg-white dark:bg-gray-800 rounded-xl shadow-lg p-8">
						<div class="w-12 h-12 bg-purple-100 dark:bg-purple-900 rounded-lg flex items-center justify-center mb-4">
							<svg class="w-6 h-6 text-purple-600 dark:text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2"></path>
							</svg>
						</div>
						<h3 class="text-xl font-semibold mb-3">Server Islands</h3>
						<p class="text-gray-600 dark:text-gray-300 mb-4">
							Server-side rendered components with dynamic content, perfect for SEO and performance.
						</p>
						<div class="space-y-2">
							<a href="/server/dynamic" class="block px-4 py-2 bg-purple-100 dark:bg-purple-900/20 text-purple-700 dark:text-purple-300 rounded-lg hover:bg-purple-200 dark:hover:bg-purple-900/40 transition-colors">
								🚀 Dynamic Content
							</a>
							<a href="/server/api" class="block px-4 py-2 bg-violet-100 dark:bg-violet-900/20 text-violet-700 dark:text-violet-300 rounded-lg hover:bg-violet-200 dark:hover:bg-violet-900/40 transition-colors">
								🔗 API Integration
							</a>
							<a href="/server/database" class="block px-4 py-2 bg-fuchsia-100 dark:bg-fuchsia-900/20 text-fuchsia-700 dark:text-fuchsia-300 rounded-lg hover:bg-fuchsia-200 dark:hover:bg-fuchsia-900/40 transition-colors">
								🗄️ Database Queries
							</a>
						</div>
					</div>

					<!-- Astro Features -->
					<div class="bg-white dark:bg-gray-800 rounded-xl shadow-lg p-8">
						<div class="w-12 h-12 bg-gradient-to-br from-orange-400 to-pink-500 rounded-lg flex items-center justify-center mb-4">
							<svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
							</svg>
						</div>
						<h3 class="text-xl font-semibold mb-3">Astro's Functionality</h3>
						<p class="text-gray-600 dark:text-gray-300 mb-4">
							Astro supports a lot of integrations out of the box other than the obvious server and client islands
						</p>
						<div class="space-y-2">
							<a href="/demo/actions" class="block px-4 py-2 bg-orange-100 dark:bg-orange-900/20 text-orange-700 dark:text-orange-300 rounded-lg hover:bg-orange-200 dark:hover:bg-orange-900/40 transition-colors">
								⚡ Astro Actions
							</a>
							<a href="/demo/view-transitions" class="block px-4 py-2 bg-pink-100 dark:bg-pink-900/20 text-pink-700 dark:text-pink-300 rounded-lg hover:bg-pink-200 dark:hover:bg-pink-900/40 transition-colors">
								🎬 View Transitions
							</a>
							<a href="/qwik-spa-auth/dashboard" class="block px-4 py-2 bg-purple-100 dark:bg-purple-900/20 text-purple-700 dark:text-purple-300 rounded-lg hover:bg-purple-200 dark:hover:bg-purple-900/40 transition-colors">
								🚀 Astro's SPA
							</a>
							<a href="/apps/partials" class="block px-4 py-2 bg-indigo-100 dark:bg-indigo-900/20 text-indigo-700 dark:text-indigo-300 rounded-lg hover:bg-indigo-200 dark:hover:bg-indigo-900/40 transition-colors">
								🧩 Astro Partials + HTMX
							</a>
						</div>
					</div>

					<!-- Routing -->
					<div class="bg-white dark:bg-gray-800 rounded-xl shadow-lg p-8">
						<div class="w-12 h-12 bg-gradient-to-br from-blue-500 to-teal-500 rounded-lg flex items-center justify-center mb-4">
							<svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m-6 3l6-3"></path>
							</svg>
						</div>
						<h3 class="text-xl font-semibold mb-3">Routing</h3>
						<p class="text-gray-600 dark:text-gray-300 mb-4">
							Explore Astro's file-based routing system with static and dynamic routes, redirects, and rewrites.
						</p>
						<div class="space-y-2">
							<a href="/apps/router" class="block px-4 py-2 bg-blue-100 dark:bg-blue-900/20 text-blue-700 dark:text-blue-300 rounded-lg hover:bg-blue-200 dark:hover:bg-blue-900/40 transition-colors">
								🛣️ Routing Examples
							</a>
						</div>
					</div>
				</div>

				<!-- File Types Section -->
				<div class="mb-16">
					<h2 class="text-3xl font-bold text-center mb-12">Astro File Types</h2>
					<p class="text-lg text-gray-600 dark:text-gray-300 text-center max-w-3xl mx-auto mb-12">
						Explore Astro's versatile file system support. Create pages using your preferred format - from Astro components to Markdown, HTML, and even API endpoints.
					</p>
					
					<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
						<!-- Astro Components -->
						<div class="bg-white dark:bg-gray-800 rounded-xl shadow-lg p-8">
							<div class="w-12 h-12 bg-gradient-to-br from-orange-400 to-pink-500 rounded-lg flex items-center justify-center mb-4">
								<svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
								</svg>
							</div>
							<h3 class="text-xl font-semibold mb-3">.astro Components</h3>
							<p class="text-gray-600 dark:text-gray-300 mb-4">
								Astro's powerful component format combining HTML, CSS, JavaScript, and server-side code.
							</p>
							<a href="/apps/file-types/astro-demo" class="block px-4 py-3 bg-gradient-to-r from-orange-500 to-pink-500 text-white rounded-lg hover:from-orange-600 hover:to-pink-600 transition-colors text-center font-medium">
								View .astro Demo
							</a>
						</div>

						<!-- Markdown -->
						<div class="bg-white dark:bg-gray-800 rounded-xl shadow-lg p-8">
							<div class="w-12 h-12 bg-gray-700 rounded-lg flex items-center justify-center mb-4">
								<span class="text-white font-bold text-lg">MD</span>
							</div>
							<h3 class="text-xl font-semibold mb-3">.md Markdown</h3>
							<p class="text-gray-600 dark:text-gray-300 mb-4">
								Write content in Markdown and let Astro transform it into beautiful HTML pages.
							</p>
							<a href="/apps/file-types/markdown-demo" class="block px-4 py-3 bg-gray-700 text-white rounded-lg hover:bg-gray-800 transition-colors text-center font-medium">
								View .md Demo
							</a>
						</div>

						<!-- MDX -->
						<div class="bg-white dark:bg-gray-800 rounded-xl shadow-lg p-8">
							<div class="w-12 h-12 bg-yellow-500 rounded-lg flex items-center justify-center mb-4">
								<span class="text-white font-bold text-lg">MDX</span>
							</div>
							<h3 class="text-xl font-semibold mb-3">.mdx Enhanced Markdown</h3>
							<p class="text-gray-600 dark:text-gray-300 mb-4">
								Markdown with JSX components for interactive content and advanced layouts.
							</p>
							<a href="/apps/file-types/mdx-demo" class="block px-4 py-3 bg-yellow-500 text-white rounded-lg hover:bg-yellow-600 transition-colors text-center font-medium">
								View .mdx Demo
							</a>
						</div>

						<!-- HTML -->
						<div class="bg-white dark:bg-gray-800 rounded-xl shadow-lg p-8">
							<div class="w-12 h-12 bg-blue-500 rounded-lg flex items-center justify-center mb-4">
								<svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path>
								</svg>
							</div>
							<h3 class="text-xl font-semibold mb-3">.html Plain HTML</h3>
							<p class="text-gray-600 dark:text-gray-300 mb-4">
								Standard HTML files served as-is, perfect for static content or legacy pages.
							</p>
							<a href="/apps/file-types/html-demo" class="block px-4 py-3 bg-blue-500 text-white rounded-lg hover:bg-blue-600 transition-colors text-center font-medium">
								View .html Demo
							</a>
						</div>

						<!-- API Endpoints -->
						<div class="bg-white dark:bg-gray-800 rounded-xl shadow-lg p-8">
							<div class="w-12 h-12 bg-green-500 rounded-lg flex items-center justify-center mb-4">
								<svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
								</svg>
							</div>
							<h3 class="text-xl font-semibold mb-3">.js/.ts API Endpoints</h3>
							<p class="text-gray-600 dark:text-gray-300 mb-4">
								Create REST API endpoints that return JSON, handle forms, or serve dynamic data.
							</p>
							<a href="/apps/file-types/api-demo" class="block px-4 py-3 bg-green-500 text-white rounded-lg hover:bg-green-600 transition-colors text-center font-medium">
								Test API Endpoint
							</a>
						</div>

						<!-- Error Pages -->
						<div class="bg-white dark:bg-gray-800 rounded-xl shadow-lg p-8">
							<div class="w-12 h-12 bg-red-500 rounded-lg flex items-center justify-center mb-4">
								<svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
								</svg>
							</div>
							<h3 class="text-xl font-semibold mb-3">Error Pages</h3>
							<p class="text-gray-600 dark:text-gray-300 mb-4">
								Custom 404 and 500 error pages for better user experience and branding.
							</p>
							<div class="space-y-2">
								<a href="/this-page-does-not-exist" class="block px-4 py-2 bg-red-100 dark:bg-red-900/20 text-red-700 dark:text-red-300 rounded-lg hover:bg-red-200 dark:hover:bg-red-900/40 transition-colors text-center">
									Test 404 Page
								</a>
								<button disabled class="block w-full px-4 py-2 bg-gray-100 dark:bg-gray-700 text-gray-400 dark:text-gray-500 rounded-lg cursor-not-allowed text-center">
									500 Page (Server Error)
								</button>
							</div>
						</div>
					</div>
				</div>

				<!-- Pages Section -->
				<div class="mb-16">
					<h2 class="text-3xl font-bold text-center mb-12">Pages & Demos</h2>
					<p class="text-lg text-gray-600 dark:text-gray-300 text-center max-w-3xl mx-auto mb-12">
						Explore the various page types and demos we've built to showcase Astro's capabilities. Each example demonstrates different patterns and best practices.
					</p>
					
					<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
						<!-- File Type Demos -->
						<div class="bg-gradient-to-br from-orange-50 to-pink-50 dark:from-orange-900/20 dark:to-pink-900/20 rounded-xl p-8">
							<h3 class="text-2xl font-bold mb-4 text-orange-800 dark:text-orange-200">File Type Demos</h3>
							<p class="text-orange-700 dark:text-orange-300 mb-6">
								Live examples of different file types Astro supports.
							</p>
							<ul class="space-y-3">
								<li class="flex items-center space-x-3">
									<div class="w-2 h-2 bg-orange-500 rounded-full"></div>
									<span class="text-orange-800 dark:text-orange-200">.astro component pages</span>
								</li>
								<li class="flex items-center space-x-3">
									<div class="w-2 h-2 bg-orange-500 rounded-full"></div>
									<span class="text-orange-800 dark:text-orange-200">Markdown & MDX content</span>
								</li>
								<li class="flex items-center space-x-3">
									<div class="w-2 h-2 bg-orange-500 rounded-full"></div>
									<span class="text-orange-800 dark:text-orange-200">API endpoints</span>
								</li>
							</ul>
						</div>

						<!-- Framework Integrations -->
						<div class="bg-gradient-to-br from-purple-50 to-blue-50 dark:from-purple-900/20 dark:to-blue-900/20 rounded-xl p-8">
							<h3 class="text-2xl font-bold mb-4 text-purple-800 dark:text-purple-200">Framework Integrations</h3>
							<p class="text-purple-700 dark:text-purple-300 mb-6">
								Working examples of different framework integrations.
							</p>
							<ul class="space-y-3">
								<li class="flex items-center space-x-3">
									<div class="w-2 h-2 bg-purple-500 rounded-full"></div>
									<span class="text-purple-800 dark:text-purple-200">SolidJS applications</span>
								</li>
								<li class="flex items-center space-x-3">
									<div class="w-2 h-2 bg-purple-500 rounded-full"></div>
									<span class="text-purple-800 dark:text-purple-200">Svelte components</span>
								</li>
								<li class="flex items-center space-x-3">
									<div class="w-2 h-2 bg-purple-500 rounded-full"></div>
									<span class="text-purple-800 dark:text-purple-200">Qwik SPAs</span>
								</li>
							</ul>
						</div>

						<!-- Special Pages -->
						<div class="bg-gradient-to-br from-red-50 to-yellow-50 dark:from-red-900/20 dark:to-yellow-900/20 rounded-xl p-8">
							<h3 class="text-2xl font-bold mb-4 text-red-800 dark:text-red-200">Special Pages</h3>
							<p class="text-red-700 dark:text-red-300 mb-6">
								Error handling and edge cases.
							</p>
							<ul class="space-y-3">
								<li class="flex items-center space-x-3">
									<div class="w-2 h-2 bg-red-500 rounded-full"></div>
									<span class="text-red-800 dark:text-red-200">Custom 404 page</span>
								</li>
								<li class="flex items-center space-x-3">
									<div class="w-2 h-2 bg-red-500 rounded-full"></div>
									<span class="text-red-800 dark:text-red-200">Custom 500 error page</span>
								</li>
								<li class="flex items-center space-x-3">
									<div class="w-2 h-2 bg-red-500 rounded-full"></div>
									<span class="text-red-800 dark:text-red-200">Dynamic routes</span>
								</li>
							</ul>
						</div>
					</div>
				</div>

				<!-- Hydration Strategies Section -->
				<div class="mb-16">
					<h2 class="text-3xl font-bold text-center mb-12">Hydration Strategies</h2>
					
					<div class="grid grid-cols-1 md:grid-cols-2 gap-8">
						<div class="bg-gradient-to-br from-blue-50 to-indigo-50 dark:from-blue-900/20 dark:to-indigo-900/20 rounded-xl p-8">
							<h3 class="text-2xl font-bold mb-4 text-blue-800 dark:text-blue-200">Partial Hydration</h3>
							<p class="text-blue-700 dark:text-blue-300 mb-6">
								Ship only the JavaScript you need. Most of your site remains static HTML for optimal performance.
							</p>
							<div class="space-y-3">
								<div class="flex items-center space-x-3">
									<div class="w-2 h-2 bg-blue-500 rounded-full"></div>
									<span class="text-blue-800 dark:text-blue-200">client:load - Hydrate immediately</span>
								</div>
								<div class="flex items-center space-x-3">
									<div class="w-2 h-2 bg-blue-500 rounded-full"></div>
									<span class="text-blue-800 dark:text-blue-200">client:idle - Hydrate when browser is idle</span>
								</div>
								<div class="flex items-center space-x-3">
									<div class="w-2 h-2 bg-blue-500 rounded-full"></div>
									<span class="text-blue-800 dark:text-blue-200">client:visible - Hydrate when in viewport</span>
								</div>
							</div>
						</div>

						<div class="bg-gradient-to-br from-purple-50 to-pink-50 dark:from-purple-900/20 dark:to-pink-900/20 rounded-xl p-8">
							<h3 class="text-2xl font-bold mb-4 text-purple-800 dark:text-purple-200">Full Hydration</h3>
							<p class="text-purple-700 dark:text-purple-300 mb-6">
								Traditional SPA approach where the entire application is hydrated on the client side.
							</p>
							<div class="space-y-3">
								<div class="flex items-center space-x-3">
									<div class="w-2 h-2 bg-purple-500 rounded-full"></div>
									<span class="text-purple-800 dark:text-purple-200">Complete framework runtime</span>
								</div>
								<div class="flex items-center space-x-3">
									<div class="w-2 h-2 bg-purple-500 rounded-full"></div>
									<span class="text-purple-800 dark:text-purple-200">Client-side routing</span>
								</div>
								<div class="flex items-center space-x-3">
