---
import Layout from 'src/layouts/Layout.astro';

// For this demo, we'll use SSG with predetermined pages
export function getStaticPaths() {
  const cities = ['san-francisco', 'new-york', 'london', 'tokyo', 'berlin'];
  const maxPages = 5; // Each city has 5 pages of events

  return cities.flatMap(city => 
    Array.from({ length: maxPages }, (_, i) => ({
      params: { 
        city: city, 
        page: (i + 1).toString() 
      }
    }))
  );
}

const { city, page } = Astro.params;
const currentPage = parseInt(page || '1');
const eventsPerPage = 6;

// Mock event data generator
function generateEvents(city: string, page: number) {
  const eventTypes = ['Conference', 'Workshop', 'Meetup', 'Seminar', 'Concert', 'Festival'];
  const topics = ['Tech', 'Art', 'Music', 'Food', 'Business', 'Health', 'Education'];
  
  const events = [];
  const startIndex = (page - 1) * eventsPerPage;
  
  for (let i = 0; i < eventsPerPage; i++) {
    const eventId = startIndex + i + 1;
    const eventType = eventTypes[eventId % eventTypes.length];
    const topic = topics[eventId % topics.length];
    const date = new Date();
    date.setDate(date.getDate() + eventId);
    
    events.push({
      id: eventId,
      title: `${topic} ${eventType} ${eventId}`,
      type: eventType,
      topic: topic,
      date: date.toLocaleDateString(),
      time: `${(eventId % 12) + 1}:00 ${eventId % 2 === 0 ? 'PM' : 'AM'}`,
      venue: `${city.split('-').map(w => w.charAt(0).toUpperCase() + w.slice(1)).join(' ')} Convention Center Hall ${String.fromCharCode(65 + (eventId % 6))}`,
      attendees: Math.floor(Math.random() * 200) + 50,
      price: eventId % 3 === 0 ? 'Free' : `$${Math.floor(Math.random() * 100) + 20}`
    });
  }
  
  return events;
}

// City data
const cityData = {
  'san-francisco': { name: 'San Francisco', emoji: '🌉', timezone: 'PST' },
  'new-york': { name: 'New York', emoji: '🗽', timezone: 'EST' },
  'london': { name: 'London', emoji: '🇬🇧', timezone: 'GMT' },
  'tokyo': { name: 'Tokyo', emoji: '🗾', timezone: 'JST' },
  'berlin': { name: 'Berlin', emoji: '🇩🇪', timezone: 'CET' }
};

const currentCity = cityData[city] || { name: city, emoji: '🏙️', timezone: 'UTC' };
const events = generateEvents(city, currentPage);
const totalPages = 5; // Known from getStaticPaths

const pageTitle = `Events in ${currentCity.name} - Page ${currentPage}`;
---

<Layout title={pageTitle}>
  <main class="min-h-screen bg-gradient-to-br from-indigo-50 to-purple-100 dark:from-indigo-900/20 dark:to-purple-900/20">
    <div class="max-w-6xl mx-auto px-4 py-16">
      <!-- Header -->
      <div class="text-center mb-12">
        <div class="text-6xl mb-4">{currentCity.emoji}</div>
        <h1 class="text-4xl font-bold mb-2">Events in {currentCity.name}</h1>
        <p class="text-xl text-gray-600 dark:text-gray-300 mb-6">
          Page {currentPage} of {totalPages} • {eventsPerPage} events per page
        </p>
        <div class="text-sm text-gray-500 dark:text-gray-400">
          Route: <span class="font-mono bg-gray-100 dark:bg-gray-800 px-2 py-1 rounded">/events/{city}/{page}</span>
        </div>
      </div>

      <!-- City Stats -->
      <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-12">
        <div class="bg-white dark:bg-gray-800 rounded-lg p-4 text-center">
          <div class="text-2xl font-bold text-indigo-600 mb-1">{currentPage}</div>
          <div class="text-sm text-gray-600 dark:text-gray-400">Current Page</div>
        </div>
        <div class="bg-white dark:bg-gray-800 rounded-lg p-4 text-center">
          <div class="text-2xl font-bold text-indigo-600 mb-1">{eventsPerPage}</div>
          <div class="text-sm text-gray-600 dark:text-gray-400">Events Shown</div>
        </div>
        <div class="bg-white dark:bg-gray-800 rounded-lg p-4 text-center">
          <div class="text-2xl font-bold text-indigo-600 mb-1">{totalPages * eventsPerPage}</div>
          <div class="text-sm text-gray-600 dark:text-gray-400">Total Events</div>
        </div>
        <div class="bg-white dark:bg-gray-800 rounded-lg p-4 text-center">
          <div class="text-2xl font-bold text-indigo-600 mb-1">{currentCity.timezone}</div>
          <div class="text-sm text-gray-600 dark:text-gray-400">Timezone</div>
        </div>
      </div>

      <!-- Events Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-12">
        {events.map((event) => (
          <div class="bg-white dark:bg-gray-800 rounded-xl shadow-lg overflow-hidden hover:shadow-xl transition-shadow">
            <div class="p-6">
              <div class="flex items-center justify-between mb-3">
                <span class="px-3 py-1 bg-indigo-100 dark:bg-indigo-900/20 text-indigo-700 dark:text-indigo-300 rounded-full text-sm font-medium">
                  {event.type}
                </span>
                <span class="text-sm text-gray-500 dark:text-gray-400">
                  #{event.id}
                </span>
              </div>
              
              <h3 class="text-lg font-semibold mb-2">{event.title}</h3>
              
              <div class="space-y-2 text-sm text-gray-600 dark:text-gray-400">
                <div class="flex items-center">
                  <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                  </svg>
                  {event.date} at {event.time}
                </div>
                
                <div class="flex items-center">
                  <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                  </svg>
                  {event.venue}
                </div>
                
                <div class="flex items-center justify-between">
                  <div class="flex items-center">
                    <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197m13.5-9a2.5 2.5 0 11-5 0 2.5 2.5 0 015 0z"></path>
                    </svg>
                    {event.attendees} attending
                  </div>
                  <span class={`font-semibold ${event.price === 'Free' ? 'text-green-600' : 'text-blue-600'}`}>
                    {event.price}
                  </span>
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>

      <!-- Pagination -->
      <div class="flex items-center justify-center space-x-2 mb-12">
        {currentPage > 1 && (
          <a 
            href={`/apps/router/events/${city}/${currentPage - 1}`}
            class="px-4 py-2 bg-white dark:bg-gray-800 border border-gray-300 dark:border-gray-600 rounded-lg hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors"
          >
            ← Previous
          </a>
        )}
        
        {Array.from({ length: totalPages }, (_, i) => i + 1).map((pageNum) => (
          <a 
            href={`/apps/router/events/${city}/${pageNum}`}
            class={`px-4 py-2 rounded-lg transition-colors ${
              pageNum === currentPage
                ? 'bg-indigo-600 text-white'
                : 'bg-white dark:bg-gray-800 border border-gray-300 dark:border-gray-600 hover:bg-gray-50 dark:hover:bg-gray-700'
            }`}
          >
            {pageNum}
          </a>
        ))}
        
        {currentPage < totalPages && (
          <a 
            href={`/apps/router/events/${city}/${currentPage + 1}`}
            class="px-4 py-2 bg-white dark:bg-gray-800 border border-gray-300 dark:border-gray-600 rounded-lg hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors"
          >
            Next →
          </a>
        )}
      </div>

      <!-- Route Implementation -->
      <div class="bg-gradient-to-r from-indigo-50 to-purple-50 dark:from-indigo-900/20 dark:to-purple-900/20 rounded-xl p-8 mb-8">
        <h2 class="text-2xl font-bold mb-6">Pagination Route Details</h2>
        <div class="space-y-4 text-sm">
          <div>
            <span class="font-semibold">File path:</span>
            <code class="ml-2 bg-white dark:bg-gray-800 px-2 py-1 rounded font-mono">
              /pages/events/[city]/[page].astro
            </code>
          </div>
          <div>
            <span class="font-semibold">Static paths:</span>
            <code class="ml-2 bg-white dark:bg-gray-800 px-2 py-1 rounded font-mono">
              Pre-generated for {Object.keys(cityData).length} cities × {totalPages} pages = {Object.keys(cityData).length * totalPages} routes
            </code>
          </div>
          <div>
            <span class="font-semibold">Current params:</span>
            <code class="ml-2 bg-white dark:bg-gray-800 px-2 py-1 rounded font-mono">
              city="{city}", page="{page}"
            </code>
          </div>
        </div>
      </div>

      <!-- Code Example -->
      <div class="bg-gray-900 rounded-xl p-6 mb-8">
        <h3 class="text-lg font-semibold text-white mb-4">Pagination Implementation</h3>
        <pre class="text-sm text-gray-300 overflow-x-auto"><code>{`---
export function getStaticPaths() {
  const cities = ['san-francisco', 'new-york', 'london'];
  const maxPages = 5;

  return cities.flatMap(city => 
    Array.from({ length: maxPages }, (_, i) => ({
      params: { 
        city: city, 
        page: (i + 1).toString() 
      }
    }))
  );
}

const { city, page } = Astro.params;
const currentPage = parseInt(page || '1');
const events = getEventsForPage(city, currentPage);
---

<h1>Events in {city} - Page {currentPage}</h1>`}</code></pre>
      </div>

      <!-- Other Cities -->
      <div class="bg-white dark:bg-gray-800 rounded-xl p-8 mb-8">
        <h3 class="text-xl font-semibold mb-6">Explore Other Cities</h3>
        <div class="grid grid-cols-2 md:grid-cols-5 gap-4">
          {Object.entries(cityData).map(([cityKey, cityInfo]) => (
            <a 
              href={`/apps/router/events/${cityKey}/1`}
              class={`block p-4 rounded-lg text-center transition-colors ${
                cityKey === city 
                  ? 'bg-indigo-100 dark:bg-indigo-900/20 text-indigo-700 dark:text-indigo-300 border-2 border-indigo-300 dark:border-indigo-600' 
                  : 'bg-gray-50 dark:bg-gray-700 hover:bg-gray-100 dark:hover:bg-gray-600'
              }`}
            >
              <div class="text-3xl mb-2">{cityInfo.emoji}</div>
              <div class="font-medium text-sm">{cityInfo.name}</div>
            </a>
          ))}
        </div>
      </div>

      <!-- Navigation -->
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <button 
          onclick="window.history.back()"
          class="inline-flex items-center justify-center px-6 py-3 bg-gray-600 text-white rounded-lg hover:bg-gray-700 transition-colors"
        >
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
          </svg>
          Go Back
        </button>
        <a 
          href="/apps/router" 
          class="inline-flex items-center justify-center px-6 py-3 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 transition-colors"
        >
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
          </svg>
          Back to Router Examples
        </a>
      </div>
    </div>
  </main>
</Layout>