---
import Layout from 'src/layouts/Layout.astro';

// For this demo, we'll use SSG with predetermined pages
export function getStaticPaths() {
  const categories = ['electronics', 'clothing', 'books', 'home'];
  const subcategories = {
    electronics: ['phones', 'laptops', 'tablets', 'cameras'],
    clothing: ['shirts', 'pants', 'shoes', 'accessories'],
    books: ['fiction', 'non-fiction', 'textbooks', 'comics'],
    home: ['furniture', 'appliances', 'decor', 'kitchen']
  };
  
  const paths = [];
  
  // Generate category pages
  categories.forEach(category => {
    paths.push({ params: { path: category } });
    
    // Generate subcategory pages
    subcategories[category].forEach(subcategory => {
      paths.push({ params: { path: `${category}/${subcategory}` } });
      
      // Generate paginated pages (1-5 for each subcategory)
      for (let page = 1; page <= 5; page++) {
        paths.push({ params: { path: `${category}/${subcategory}/${page}` } });
      }
    });
  });
  
  return paths;
}

const { path } = Astro.params;

// Parse the path
const pathParts = path ? path.split('/').filter(Boolean) : [];
const [category, subcategory, page] = pathParts;
const currentPage = page ? parseInt(page) : 1;

// Mock marketplace data
const marketplaceData = {
  electronics: {
    name: 'Electronics',
    emoji: '📱',
    subcategories: {
      phones: { name: 'Smartphones', emoji: '📱', itemCount: 245 },
      laptops: { name: 'Laptops', emoji: '💻', itemCount: 156 },
      tablets: { name: 'Tablets', emoji: '📱', itemCount: 89 },
      cameras: { name: 'Cameras', emoji: '📷', itemCount: 123 }
    }
  },
  clothing: {
    name: 'Clothing',
    emoji: '👕',
    subcategories: {
      shirts: { name: 'Shirts', emoji: '👕', itemCount: 389 },
      pants: { name: 'Pants', emoji: '👖', itemCount: 267 },
      shoes: { name: 'Shoes', emoji: '👟', itemCount: 445 },
      accessories: { name: 'Accessories', emoji: '🎒', itemCount: 178 }
    }
  },
  books: {
    name: 'Books',
    emoji: '📚',
    subcategories: {
      fiction: { name: 'Fiction', emoji: '📖', itemCount: 567 },
      'non-fiction': { name: 'Non-Fiction', emoji: '📘', itemCount: 423 },
      textbooks: { name: 'Textbooks', emoji: '📚', itemCount: 234 },
      comics: { name: 'Comics', emoji: '📝', itemCount: 189 }
    }
  },
  home: {
    name: 'Home & Garden',
    emoji: '🏠',
    subcategories: {
      furniture: { name: 'Furniture', emoji: '🪑', itemCount: 345 },
      appliances: { name: 'Appliances', emoji: '🔌', itemCount: 167 },
      decor: { name: 'Decor', emoji: '🖼️', itemCount: 289 },
      kitchen: { name: 'Kitchen', emoji: '🍳', itemCount: 223 }
    }
  }
};

// Generate mock products
function generateProducts(category: string, subcategory: string, page: number) {
  const productsPerPage = 12;
  const startIndex = (page - 1) * productsPerPage;
  const products = [];
  
  for (let i = 0; i < productsPerPage; i++) {
    const productId = startIndex + i + 1;
    const brands = ['Apple', 'Samsung', 'Sony', 'LG', 'Dell', 'HP', 'Nike', 'Adidas'];
    const brand = brands[productId % brands.length];
    
    products.push({
      id: productId,
      name: `${brand} ${subcategory.slice(0, -1)} ${productId}`,
      price: Math.floor(Math.random() * 1000) + 50,
      rating: (3.5 + Math.random() * 1.5).toFixed(1),
      reviews: Math.floor(Math.random() * 500) + 10,
      image: marketplaceData[category]?.subcategories[subcategory]?.emoji || '📦'
    });
  }
  
  return products;
}

const currentCategory = marketplaceData[category];
const currentSubcategory = currentCategory?.subcategories[subcategory];

// Build breadcrumb
const breadcrumb = [
  { name: 'Router', url: '/apps/router' },
  { name: 'Marketplace', url: '/apps/router/marketplace' }
];

if (category) breadcrumb.push({ 
  name: currentCategory?.name || category, 
  url: `/apps/router/marketplace/${category}` 
});

if (subcategory) breadcrumb.push({ 
  name: currentSubcategory?.name || subcategory, 
  url: `/apps/router/marketplace/${category}/${subcategory}` 
});

if (page) breadcrumb.push({ 
  name: `Page ${page}`, 
  url: `/apps/router/marketplace/${category}/${subcategory}/${page}` 
});

const products = subcategory && page ? generateProducts(category, subcategory, currentPage) : [];
const totalPages = 5; // From getStaticPaths

const pageTitle = page 
  ? `${currentSubcategory?.name || subcategory} - Page ${page}`
  : subcategory 
    ? currentSubcategory?.name || subcategory
    : currentCategory?.name || category || 'Marketplace';
---

<Layout title={pageTitle}>
  <main class="min-h-screen bg-gradient-to-br from-green-50 to-emerald-100 dark:from-green-900/20 dark:to-emerald-900/20">
    <div class="max-w-7xl mx-auto px-4 py-16">
      <!-- Breadcrumb -->
      <nav class="mb-8">
        <ol class="flex flex-wrap items-center space-x-2 text-sm text-gray-600 dark:text-gray-400">
          {breadcrumb.map((crumb, index) => (
            <li class="flex items-center">
              {index > 0 && <span class="mx-2 text-gray-400">/</span>}
              <a href={crumb.url} class="hover:text-green-600 dark:hover:text-green-400">
                {crumb.name}
              </a>
            </li>
          ))}
        </ol>
      </nav>

      <!-- Header -->
      <div class="text-center mb-12">
        <div class="text-6xl mb-4">
          {currentSubcategory?.emoji || currentCategory?.emoji || '🛍️'}
        </div>
        <h1 class="text-4xl font-bold mb-4 text-gray-900 dark:text-white">{pageTitle}</h1>
        <p class="text-xl text-gray-600 dark:text-gray-300 mb-6">
          {page ? `Showing page ${page} of ${totalPages}` : 'Browse our marketplace'}
        </p>
        <div class="text-sm text-gray-500 dark:text-gray-400">
          Path: <span class="font-mono bg-gray-100 dark:bg-gray-800 px-2 py-1 rounded">/marketplace/{path || ''}</span>
        </div>
      </div>

      <!-- Stats -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-12">
        <div class="bg-white dark:bg-gray-800 rounded-lg p-4 text-center">
          <div class="text-2xl font-bold text-green-600 dark:text-green-400 mb-1">{pathParts.length}</div>
          <div class="text-sm text-gray-600 dark:text-gray-400">Path Depth</div>
        </div>
        <div class="bg-white dark:bg-gray-800 rounded-lg p-4 text-center">
          <div class="text-2xl font-bold text-green-600 dark:text-green-400 mb-1">{currentSubcategory?.itemCount || 'All'}</div>
          <div class="text-sm text-gray-600 dark:text-gray-400">Total Items</div>
        </div>
        <div class="bg-white dark:bg-gray-800 rounded-lg p-4 text-center">
          <div class="text-2xl font-bold text-green-600 dark:text-green-400 mb-1">{page || 'Overview'}</div>
          <div class="text-sm text-gray-600 dark:text-gray-400">Current Page</div>
        </div>
        <div class="bg-white dark:bg-gray-800 rounded-lg p-4 text-center">
          <div class="text-2xl font-bold text-green-600 dark:text-green-400 mb-1">{products.length}</div>
          <div class="text-sm text-gray-600 dark:text-gray-400">Items Shown</div>
        </div>
      </div>

      <!-- Route Information -->
      <div class="bg-green-50 dark:bg-green-900/20 rounded-xl p-6 mb-8 border border-green-200 dark:border-green-800">
        <h2 class="text-lg font-semibold text-green-800 dark:text-green-200 mb-4">Nested Marketplace Route</h2>
        <div class="space-y-3 text-sm">
          <div>
            <span class="font-semibold">File:</span>
            <code class="ml-2 bg-white dark:bg-gray-800 px-2 py-1 rounded font-mono">
              /marketplace/[...path].astro
            </code>
          </div>
          <div>
            <span class="font-semibold">Handles:</span>
            <code class="ml-2 bg-white dark:bg-gray-800 px-2 py-1 rounded font-mono">
              /marketplace/category/subcategory/page
            </code>
          </div>
          <div>
            <span class="font-semibold">Current path:</span>
            <code class="ml-2 bg-white dark:bg-gray-800 px-2 py-1 rounded font-mono">
              [{pathParts.map(part => `"${part}"`).join(', ')}]
            </code>
          </div>
          <div>
            <span class="font-semibold">Parsed as:</span>
            <span class="ml-2 text-green-700 dark:text-green-300">
              Category: "{category}", Subcategory: "{subcategory}", Page: "{page || 'N/A'}"
            </span>
          </div>
        </div>
      </div>

      {/* Show categories if no category selected */}
      {!category && (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
          {Object.entries(marketplaceData).map(([categoryKey, categoryData]) => (
            <a 
              href={`/apps/router/marketplace/${categoryKey}`}
              class="block bg-white dark:bg-gray-800 rounded-xl p-6 hover:shadow-lg transition-shadow"
            >
              <div class="text-4xl mb-4 text-center">{categoryData.emoji}</div>
              <h3 class="text-xl font-semibold text-center text-gray-900 dark:text-white">{categoryData.name}</h3>
              <p class="text-sm text-gray-600 dark:text-gray-400 text-center mt-2">
                {Object.keys(categoryData.subcategories).length} subcategories
              </p>
            </a>
          ))}
        </div>
      )}

      {/* Show subcategories if category but no subcategory */}
      {category && !subcategory && (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
          {Object.entries(currentCategory.subcategories).map(([subKey, subData]) => (
            <a 
              href={`/apps/router/marketplace/${category}/${subKey}`}
              class="block bg-white dark:bg-gray-800 rounded-xl p-6 hover:shadow-lg transition-shadow"
            >
              <div class="text-4xl mb-4 text-center">{subData.emoji}</div>
              <h3 class="text-xl font-semibold text-center text-gray-900 dark:text-white">{subData.name}</h3>
              <p class="text-sm text-gray-600 dark:text-gray-400 text-center mt-2">
                {subData.itemCount} items
              </p>
            </a>
          ))}
        </div>
      )}

      {/* Show pagination links if subcategory but no page */}
      {category && subcategory && !page && (
        <div class="bg-white dark:bg-gray-800 rounded-xl p-8 mb-8">
          <h3 class="text-xl font-semibold mb-6 text-gray-900 dark:text-white">Browse {currentSubcategory?.name}</h3>
          <div class="flex flex-wrap gap-4 justify-center">
            {Array.from({ length: totalPages }, (_, i) => i + 1).map((pageNum) => (
              <a 
                href={`/apps/router/marketplace/${category}/${subcategory}/${pageNum}`}
                class="px-6 py-3 bg-green-100 dark:bg-green-900/20 text-green-700 dark:text-green-300 rounded-lg hover:bg-green-200 dark:hover:bg-green-900/40 transition-colors font-medium"
              >
                Page {pageNum}
              </a>
            ))}
          </div>
        </div>
      )}

      {/* Show products if we have a page */}
      {products.length > 0 && (
        <>
          <!-- Products Grid -->
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6 mb-12">
            {products.map((product) => (
              <div class="bg-white dark:bg-gray-800 rounded-xl shadow-lg overflow-hidden hover:shadow-xl transition-shadow">
                <div class="p-6">
                  <div class="text-4xl text-center mb-4">{product.image}</div>
                  <h3 class="font-semibold mb-2 text-gray-900 dark:text-white">{product.name}</h3>
                  <div class="flex items-center justify-between mb-3">
                    <span class="text-2xl font-bold text-green-600 dark:text-green-400">${product.price}</span>
                    <div class="flex items-center">
                      <span class="text-yellow-500">★</span>
                      <span class="ml-1 text-sm text-gray-600 dark:text-gray-400">{product.rating}</span>
                    </div>
                  </div>
                  <p class="text-sm text-gray-600 dark:text-gray-400">{product.reviews} reviews</p>
                </div>
              </div>
            ))}
          </div>

          <!-- Pagination -->
          <div class="flex items-center justify-center space-x-2 mb-8">
            {currentPage > 1 && (
              <a 
                href={`/apps/router/marketplace/${category}/${subcategory}/${currentPage - 1}`}
                class="px-4 py-2 bg-white dark:bg-gray-800 border border-gray-300 dark:border-gray-600 rounded-lg hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors text-gray-900 dark:text-white"
              >
                ← Previous
              </a>
            )}
            
            {Array.from({ length: totalPages }, (_, i) => i + 1).map((pageNum) => (
              <a 
                href={`/apps/router/marketplace/${category}/${subcategory}/${pageNum}`}
                class={`px-4 py-2 rounded-lg transition-colors ${
                  pageNum === currentPage
                    ? 'bg-green-600 text-white'
                    : 'bg-white dark:bg-gray-800 border border-gray-300 dark:border-gray-600 hover:bg-gray-50 dark:hover:bg-gray-700 text-gray-900 dark:text-white'
                }`}
              >
                {pageNum}
              </a>
            ))}
            
            {currentPage < totalPages && (
              <a 
                href={`/apps/router/marketplace/${category}/${subcategory}/${currentPage + 1}`}
                class="px-4 py-2 bg-white dark:bg-gray-800 border border-gray-300 dark:border-gray-600 rounded-lg hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors text-gray-900 dark:text-white"
              >
                Next →
              </a>
            )}
          </div>
        </>
      )}

      <!-- Example URLs -->
      <div class="bg-blue-50 dark:bg-blue-900/20 rounded-lg p-6 mb-8 border border-blue-200 dark:border-blue-800">
        <h3 class="font-semibold text-blue-800 dark:text-blue-200 mb-4">Try These Marketplace Paths</h3>
        <div class="space-y-2 text-sm">
          <div>
            <code class="bg-white dark:bg-gray-800 px-2 py-1 rounded">/marketplace/electronics</code>
            <span class="ml-2 text-blue-600 dark:text-blue-400">→ Electronics category</span>
          </div>
          <div>
            <code class="bg-white dark:bg-gray-800 px-2 py-1 rounded">/marketplace/electronics/phones</code>
            <span class="ml-2 text-blue-600 dark:text-blue-400">→ Phone subcategory</span>
          </div>
          <div>
            <code class="bg-white dark:bg-gray-800 px-2 py-1 rounded">/marketplace/electronics/phones/2</code>
            <span class="ml-2 text-blue-600 dark:text-blue-400">→ Page 2 of phones</span>
          </div>
          <div>
            <code class="bg-white dark:bg-gray-800 px-2 py-1 rounded">/marketplace/clothing/shoes/1</code>
            <span class="ml-2 text-blue-600 dark:text-blue-400">→ Page 1 of shoes</span>
          </div>
        </div>
      </div>

      <!-- Code Example -->
      <div class="bg-gray-900 dark:bg-gray-900 rounded-xl p-6 mb-8">
        <h3 class="text-lg font-semibold text-white mb-4">Nested Marketplace Implementation</h3>
        <pre class="text-sm text-gray-300 overflow-x-auto"><code>{`---
// File: /marketplace/[...path].astro
export function getStaticPaths() {
  // Pre-generate all possible marketplace paths
  return [
    { params: { path: 'electronics' } },
    { params: { path: 'electronics/phones' } },
    { params: { path: 'electronics/phones/1' } },
    { params: { path: 'electronics/phones/2' } },
    // ... more paths
  ];
}

const { path } = Astro.params;
const [category, subcategory, page] = path.split('/');
---

<h1>{category} → {subcategory} → Page {page}</h1>`}</code></pre>
      </div>

      <!-- Back Navigation -->
      <div class="text-center">
        <a 
          href="/apps/router" 
          class="inline-flex items-center px-6 py-3 bg-green-600 text-white rounded-lg hover:bg-green-700 transition-colors"
        >
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
          </svg>
          Back to Router Examples
        </a>
      </div>
    </div>
  </main>
</Layout>