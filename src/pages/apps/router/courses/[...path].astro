---
import Layout from 'src/layouts/Layout.astro';

export const prerender = false;

const { path } = Astro.params;

// Parse the path into course structure
const pathParts = path ? path.split('/').filter(Boolean) : [];
const [category, course, section, ...remaining] = pathParts;

// Mock course data
const courseData = {
  javascript: {
    name: 'JavaScript Fundamentals',
    description: 'Complete JavaScript course from basics to advanced',
    sections: {
      basics: {
        name: 'JavaScript Basics',
        lessons: {
          variables: {
            name: 'Variables and Data Types',
            content: ['scope', 'hoisting', 'let-vs-var', 'constants']
          },
          functions: {
            name: 'Functions',
            content: ['declarations', 'expressions', 'arrow-functions', 'closures']
          },
          objects: {
            name: 'Objects and Arrays',
            content: ['object-literals', 'array-methods', 'destructuring', 'spread-operator']
          }
        }
      },
      advanced: {
        name: 'Advanced JavaScript',
        lessons: {
          async: {
            name: 'Asynchronous JavaScript',
            content: ['promises', 'async-await', 'fetch-api', 'error-handling']
          },
          modules: {
            name: 'ES6 Modules',
            content: ['import-export', 'default-exports', 'dynamic-imports', 'bundling']
          }
        }
      }
    }
  },
  react: {
    name: 'React Development',
    description: 'Modern React development with hooks and patterns',
    sections: {
      fundamentals: {
        name: 'React Fundamentals',
        lessons: {
          components: {
            name: 'Components and JSX',
            content: ['functional-components', 'jsx-syntax', 'props', 'children']
          },
          state: {
            name: 'State Management',
            content: ['usestate', 'useeffect', 'usecontext', 'custom-hooks']
          }
        }
      }
    }
  }
};

const currentCourse = courseData[category];
const currentSection = currentCourse?.sections[course];
const currentLesson = currentSection?.lessons[section];
const currentContent = currentLesson?.content;
const specificContent = remaining[0];

// Build breadcrumb
const breadcrumb = [
  { name: 'Router', url: '/apps/router' },
  { name: 'Courses', url: '/apps/router/courses' }
];

if (category) breadcrumb.push({ name: currentCourse?.name || category, url: `/apps/router/courses/${category}` });
if (course) breadcrumb.push({ name: currentSection?.name || course, url: `/apps/router/courses/${category}/${course}` });
if (section) breadcrumb.push({ name: currentLesson?.name || section, url: `/apps/router/courses/${category}/${course}/${section}` });
if (remaining.length > 0) {
  remaining.forEach((part, index) => {
    const partialPath = remaining.slice(0, index + 1).join('/');
    breadcrumb.push({ 
      name: part.replace('-', ' '), 
      url: `/apps/router/courses/${category}/${course}/${section}/${partialPath}` 
    });
  });
}

const pageTitle = specificContent 
  ? `${specificContent.replace('-', ' ')} - ${currentLesson?.name || section}`
  : currentLesson?.name || section || course || category || 'Learning Platform';
---

<Layout title={pageTitle}>
  <main class="min-h-screen bg-gradient-to-br from-purple-50 to-pink-100 dark:from-purple-900/20 dark:to-pink-900/20">
    <div class="max-w-6xl mx-auto px-4 py-16">
      <!-- Breadcrumb -->
      <nav class="mb-8">
        <ol class="flex flex-wrap items-center space-x-2 text-sm text-gray-600 dark:text-gray-400">
          {breadcrumb.map((crumb, index) => (
            <li class="flex items-center">
              {index > 0 && <span class="mx-2 text-gray-400">/</span>}
              <a href={crumb.url} class="hover:text-purple-600 dark:hover:text-purple-400">
                {crumb.name}
              </a>
            </li>
          ))}
        </ol>
      </nav>

      <!-- Header -->
      <div class="text-center mb-12">
        <div class="text-6xl mb-4">📚</div>
        <h1 class="text-4xl font-bold mb-4 text-gray-900 dark:text-white">
          {pageTitle}
        </h1>
        <p class="text-xl text-gray-600 dark:text-gray-300 mb-6">
          Deep Learning Path with Rest Parameters
        </p>
        <div class="text-sm text-gray-500 dark:text-gray-400">
          Path: <span class="font-mono bg-gray-100 dark:bg-gray-800 px-2 py-1 rounded">/courses/{path || ''}</span>
        </div>
      </div>

      <!-- Course Progress -->
      <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-12">
        <div class="bg-white dark:bg-gray-800 rounded-lg p-4 text-center">
          <div class="text-2xl font-bold text-purple-600 dark:text-purple-400 mb-1">{pathParts.length}</div>
          <div class="text-sm text-gray-600 dark:text-gray-400">Path Depth</div>
        </div>
        <div class="bg-white dark:bg-gray-800 rounded-lg p-4 text-center">
          <div class="text-2xl font-bold text-purple-600 dark:text-purple-400 mb-1">{category || 'All'}</div>
          <div class="text-sm text-gray-600 dark:text-gray-400">Category</div>
        </div>
        <div class="bg-white dark:bg-gray-800 rounded-lg p-4 text-center">
          <div class="text-2xl font-bold text-purple-600 dark:text-purple-400 mb-1">{course || 'Overview'}</div>
          <div class="text-sm text-gray-600 dark:text-gray-400">Course</div>
        </div>
        <div class="bg-white dark:bg-gray-800 rounded-lg p-4 text-center">
          <div class="text-2xl font-bold text-purple-600 dark:text-purple-400 mb-1">{section || 'Intro'}</div>
          <div class="text-sm text-gray-600 dark:text-gray-400">Section</div>
        </div>
      </div>

      <!-- Rest Parameter Route Explanation -->
      <div class="bg-purple-50 dark:bg-purple-900/20 rounded-xl p-6 mb-8 border border-purple-200 dark:border-purple-800">
        <h2 class="text-lg font-semibold text-purple-800 dark:text-purple-200 mb-4">Rest Parameter Route</h2>
        <div class="space-y-3 text-sm">
          <div>
            <span class="font-semibold">File:</span>
            <code class="ml-2 bg-white dark:bg-gray-800 px-2 py-1 rounded font-mono">
              /courses/[...path].astro
            </code>
          </div>
          <div>
            <span class="font-semibold">Handles:</span>
            <code class="ml-2 bg-white dark:bg-gray-800 px-2 py-1 rounded font-mono">
              /courses/any/nested/path/structure
            </code>
          </div>
          <div>
            <span class="font-semibold">Current path:</span>
            <code class="ml-2 bg-white dark:bg-gray-800 px-2 py-1 rounded font-mono">
              [{pathParts.map(part => `"${part}"`).join(', ')}]
            </code>
          </div>
          <div>
            <span class="font-semibold">Parsed as:</span>
            <span class="ml-2 text-purple-700 dark:text-purple-300">
              Category: "{category}", Course: "{course}", Section: "{section}", Content: "{specificContent || 'overview'}"
            </span>
          </div>
        </div>
      </div>

      <!-- Current Content -->
      {currentLesson && (
        <div class="bg-white dark:bg-gray-800 rounded-xl p-8 mb-8">
          <h2 class="text-2xl font-bold mb-6 text-gray-900 dark:text-white">{currentLesson.name}</h2>
          
          {specificContent ? (
            <div class="space-y-6">
              <div class="bg-gradient-to-r from-purple-100 to-pink-100 dark:from-purple-900/30 dark:to-pink-900/30 rounded-lg p-6">
                <h3 class="text-xl font-semibold mb-4 text-gray-900 dark:text-white">
                  {specificContent.replace('-', ' ').replace(/\b\w/g, l => l.toUpperCase())}
                </h3>
                <p class="text-gray-700 dark:text-gray-300">
                  This is the detailed content for "{specificContent}" within the {currentLesson.name} lesson. 
                  The rest parameter allows us to handle unlimited nesting depth in our course structure.
                </p>
              </div>
              
              <!-- Related Content -->
              <div>
                <h4 class="font-semibold mb-3 text-gray-900 dark:text-white">Related Topics in this Lesson:</h4>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                  {currentContent?.filter(c => c !== specificContent).map((topic) => (
                    <a 
                      href={`/apps/router/courses/${category}/${course}/${section}/${topic}`}
                      class="block p-3 bg-purple-100 dark:bg-purple-900/20 text-purple-700 dark:text-purple-300 rounded-lg hover:bg-purple-200 dark:hover:bg-purple-900/40 transition-colors"
                    >
                      {topic.replace('-', ' ').replace(/\b\w/g, l => l.toUpperCase())}
                    </a>
                  ))}
                </div>
              </div>
            </div>
          ) : (
            <div class="space-y-6">
              <p class="text-gray-700 dark:text-gray-300">
                Welcome to the {currentLesson.name} lesson. This lesson covers the following topics:
              </p>
              
              <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                {currentContent?.map((topic) => (
                  <a 
                    href={`/apps/router/courses/${category}/${course}/${section}/${topic}`}
                    class="block p-4 bg-gradient-to-r from-purple-100 to-pink-100 dark:from-purple-900/30 dark:to-pink-900/30 rounded-lg hover:from-purple-200 hover:to-pink-200 dark:hover:from-purple-900/50 dark:hover:to-pink-900/50 transition-colors"
                  >
                    <div class="font-semibold text-gray-900 dark:text-white mb-2">
                      {topic.replace('-', ' ').replace(/\b\w/g, l => l.toUpperCase())}
                    </div>
                    <div class="text-sm text-gray-600 dark:text-gray-400">
                      Learn about {topic.replace('-', ' ')} in detail
                    </div>
                  </a>
                ))}
              </div>
            </div>
          )}
        </div>
      )}

      <!-- Course Navigation -->
      {currentSection && (
        <div class="bg-white dark:bg-gray-800 rounded-xl p-8 mb-8">
          <h3 class="text-xl font-semibold mb-6 text-gray-900 dark:text-white">Other Lessons in {currentSection.name}</h3>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
            {Object.entries(currentSection.lessons).map(([lessonKey, lessonData]) => (
              <a 
                href={`/apps/router/courses/${category}/${course}/${lessonKey}`}
                class={`block p-4 rounded-lg transition-colors ${
                  lessonKey === section 
                    ? 'bg-purple-100 dark:bg-purple-900/20 text-purple-700 dark:text-purple-300 border-2 border-purple-300 dark:border-purple-600' 
                    : 'bg-gray-50 dark:bg-gray-700 hover:bg-gray-100 dark:hover:bg-gray-600'
                }`}
              >
                <div class="font-semibold text-gray-900 dark:text-white">{lessonData.name}</div>
                <div class="text-sm text-gray-600 dark:text-gray-400 mt-1">
                  {lessonData.content.length} topics
                </div>
              </a>
            ))}
          </div>
        </div>
      )}

      <!-- Example URLs -->
      <div class="bg-blue-50 dark:bg-blue-900/20 rounded-lg p-6 mb-8 border border-blue-200 dark:border-blue-800">
        <h3 class="font-semibold text-blue-800 dark:text-blue-200 mb-4">Try These Deep Learning Paths</h3>
        <div class="space-y-2 text-sm">
          <div>
            <code class="bg-white dark:bg-gray-800 px-2 py-1 rounded">/courses/javascript/basics</code>
            <span class="ml-2 text-blue-600 dark:text-blue-400">→ Course overview</span>
          </div>
          <div>
            <code class="bg-white dark:bg-gray-800 px-2 py-1 rounded">/courses/javascript/basics/variables</code>
            <span class="ml-2 text-blue-600 dark:text-blue-400">→ Variables lesson</span>
          </div>
          <div>
            <code class="bg-white dark:bg-gray-800 px-2 py-1 rounded">/courses/javascript/basics/variables/scope</code>
            <span class="ml-2 text-blue-600 dark:text-blue-400">→ Scope topic</span>
          </div>
          <div>
            <code class="bg-white dark:bg-gray-800 px-2 py-1 rounded">/courses/react/fundamentals/components/jsx-syntax</code>
            <span class="ml-2 text-blue-600 dark:text-blue-400">→ React JSX topic</span>
          </div>
        </div>
      </div>

      <!-- Code Example -->
      <div class="bg-gray-900 dark:bg-gray-900 rounded-xl p-6 mb-8">
        <h3 class="text-lg font-semibold text-white mb-4">Rest Parameter Implementation</h3>
        <pre class="text-sm text-gray-300 overflow-x-auto"><code>{`---
// File: /courses/[...path].astro
const { path } = Astro.params;

// Parse unlimited depth path
const pathParts = path ? path.split('/').filter(Boolean) : [];
const [category, course, section, ...remaining] = pathParts;

// This route handles:
// /courses/javascript
// /courses/javascript/basics
// /courses/javascript/basics/variables
// /courses/javascript/basics/variables/scope
// /courses/any/deep/nested/path/structure
---

<h1>{category} → {course} → {section}</h1>`}</code></pre>
      </div>

      <!-- Navigation -->
      <div class="text-center">
        <a 
          href="/apps/router" 
          class="inline-flex items-center px-6 py-3 bg-purple-600 text-white rounded-lg hover:bg-purple-700 transition-colors"
        >
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
          </svg>
          Back to Router Examples
        </a>
      </div>
    </div>
  </main>
</Layout>