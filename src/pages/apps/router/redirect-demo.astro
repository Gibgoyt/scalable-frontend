---
import Layout from 'src/layouts/Layout.astro';

// This page demonstrates redirects
// Check if we should redirect based on query parameters
const url = new URL(Astro.request.url);
const shouldRedirect = url.searchParams.get('redirect');
const redirectTo = url.searchParams.get('to');

if (shouldRedirect === 'true' && redirectTo) {
  return Astro.redirect(redirectTo);
}

// Simulate different redirect scenarios
const redirectExamples = [
  {
    title: 'Simple Redirect',
    description: 'Redirect to another page immediately',
    url: '/apps/router/redirect-demo?redirect=true&to=/apps/router/static-example',
    type: 'Immediate'
  },
  {
    title: 'Conditional Redirect',
    description: 'Redirect based on user conditions',
    url: '/apps/router/redirect-demo?redirect=true&to=/apps/router/dynamic-example',
    type: 'Conditional'
  },
  {
    title: 'External Redirect',
    description: 'Redirect to external website',
    url: '/apps/router/redirect-demo?redirect=true&to=https://docs.astro.build/en/guides/routing/',
    type: 'External'
  }
];

export const prerender = false; // SSR for redirect logic
---

<Layout title="Redirect Demo - Astro Routing">
  <main class="min-h-screen bg-gradient-to-br from-orange-50 to-red-100 dark:from-orange-900/20 dark:to-red-900/20">
    <div class="max-w-4xl mx-auto px-4 py-16">
      <!-- Header -->
      <div class="text-center mb-12">
        <div class="inline-flex items-center justify-center w-16 h-16 bg-orange-500 rounded-full mb-6">
          <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5M7 12h11"></path>
          </svg>
        </div>
        <h1 class="text-4xl font-bold mb-4 text-gray-900 dark:text-white">Redirect Demonstration</h1>
        <p class="text-xl text-gray-600 dark:text-gray-300">Learn how Astro handles redirects</p>
      </div>

      <!-- Redirect Types -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12">
        {redirectExamples.map((example) => (
          <div class="bg-white dark:bg-gray-800 rounded-xl p-6 shadow-lg">
            <h3 class="text-lg font-semibold mb-3 text-gray-900 dark:text-white">{example.title}</h3>
            <p class="text-gray-600 dark:text-gray-300 mb-4 text-sm">{example.description}</p>
            <div class="mb-4">
              <span class={`px-3 py-1 rounded-full text-sm font-medium ${
                example.type === 'Immediate' ? 'bg-green-100 dark:bg-green-900/20 text-green-700 dark:text-green-300' :
                example.type === 'Conditional' ? 'bg-blue-100 dark:bg-blue-900/20 text-blue-700 dark:text-blue-300' :
                'bg-purple-100 dark:bg-purple-900/20 text-purple-700 dark:text-purple-300'
              }`}>
                {example.type}
              </span>
            </div>
            <a 
              href={example.url}
              class="block w-full px-4 py-2 bg-orange-600 text-white rounded-lg hover:bg-orange-700 transition-colors text-center font-medium"
            >
              Test Redirect
            </a>
          </div>
        ))}
      </div>

      <!-- How Redirects Work -->
      <div class="bg-orange-50 dark:bg-orange-900/20 rounded-xl p-8 mb-8 border border-orange-200 dark:border-orange-800">
        <h2 class="text-2xl font-bold mb-6 text-gray-900 dark:text-white">How Astro Redirects Work</h2>
        
        <div class="space-y-6">
          <!-- Server-side Redirects -->
          <div class="bg-white dark:bg-gray-800 rounded-lg p-6">
            <h3 class="text-lg font-semibold mb-4 text-gray-900 dark:text-white flex items-center">
              <svg class="w-5 h-5 mr-2 text-orange-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2"></path>
              </svg>
              Server-side Redirects (SSR)
            </h3>
            <p class="text-gray-600 dark:text-gray-300 mb-4">
              Use <code class="bg-gray-100 dark:bg-gray-700 px-2 py-1 rounded">Astro.redirect()</code> to redirect users before the page renders.
            </p>
            <div class="bg-gray-900 dark:bg-gray-900 rounded-lg p-4">
              <pre class="text-sm text-gray-300"><code>{`---
// Check authentication
const user = await getUser(Astro.request);

if (!user) {
  return Astro.redirect('/login');
}

// Check permissions
if (!user.hasAccess) {
  return Astro.redirect('/unauthorized');
}
---

<h1>Protected Content</h1>`}</code></pre>
            </div>
          </div>

          <!-- Configured Redirects -->
          <div class="bg-white dark:bg-gray-800 rounded-lg p-6">
            <h3 class="text-lg font-semibold mb-4 text-gray-900 dark:text-white flex items-center">
              <svg class="w-5 h-5 mr-2 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
              </svg>
              Configured Redirects (astro.config.mjs)
            </h3>
            <p class="text-gray-600 dark:text-gray-300 mb-4">
              Set up permanent redirects in your Astro configuration for URL migrations.
            </p>
            <div class="bg-gray-900 dark:bg-gray-900 rounded-lg p-4">
              <pre class="text-sm text-gray-300"><code>{`// astro.config.mjs
export default defineConfig({
  redirects: {
    '/old-blog': '/blog',
    '/products/[id]': '/shop/[id]',
    '/legacy-path': {
      status: 301,
      destination: '/new-path'
    }
  }
});`}</code></pre>
            </div>
          </div>
        </div>
      </div>

      <!-- Redirect Use Cases -->
      <div class="bg-white dark:bg-gray-800 rounded-xl p-8 mb-8">
        <h3 class="text-xl font-semibold mb-6 text-gray-900 dark:text-white">Common Redirect Use Cases</h3>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="space-y-4">
            <h4 class="font-semibold text-gray-900 dark:text-white">Authentication & Authorization</h4>
            <ul class="space-y-2 text-sm text-gray-600 dark:text-gray-400">
              <li class="flex items-start">
                <span class="w-2 h-2 bg-orange-500 rounded-full mt-2 mr-3 flex-shrink-0"></span>
                Redirect unauthenticated users to login
              </li>
              <li class="flex items-start">
                <span class="w-2 h-2 bg-orange-500 rounded-full mt-2 mr-3 flex-shrink-0"></span>
                Redirect after successful login
              </li>
              <li class="flex items-start">
                <span class="w-2 h-2 bg-orange-500 rounded-full mt-2 mr-3 flex-shrink-0"></span>
                Role-based page access control
              </li>
            </ul>
          </div>
          
          <div class="space-y-4">
            <h4 class="font-semibold text-gray-900 dark:text-white">URL Management</h4>
            <ul class="space-y-2 text-sm text-gray-600 dark:text-gray-400">
              <li class="flex items-start">
                <span class="w-2 h-2 bg-orange-500 rounded-full mt-2 mr-3 flex-shrink-0"></span>
                Legacy URL migrations
              </li>
              <li class="flex items-start">
                <span class="w-2 h-2 bg-orange-500 rounded-full mt-2 mr-3 flex-shrink-0"></span>
                SEO-friendly URL restructuring
              </li>
              <li class="flex items-start">
                <span class="w-2 h-2 bg-orange-500 rounded-full mt-2 mr-3 flex-shrink-0"></span>
                Canonical URL enforcement
              </li>
            </ul>
          </div>
        </div>
      </div>

      <!-- Current Request Info -->
      <div class="bg-gradient-to-r from-orange-100 to-red-100 dark:from-orange-900/30 dark:to-red-900/30 rounded-xl p-8 mb-8">
        <h3 class="text-xl font-semibold mb-6 text-gray-900 dark:text-white">Current Request Information</h3>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 text-sm">
          <div>
            <span class="font-semibold text-gray-700 dark:text-gray-300">URL:</span>
            <code class="ml-2 bg-white dark:bg-gray-800 px-2 py-1 rounded text-xs break-all">
              {Astro.url.href}
            </code>
          </div>
          <div>
            <span class="font-semibold text-gray-700 dark:text-gray-300">Query Params:</span>
            <code class="ml-2 bg-white dark:bg-gray-800 px-2 py-1 rounded text-xs">
              {Astro.url.search || 'none'}
            </code>
          </div>
        </div>
        
        {shouldRedirect && (
          <div class="mt-4 p-4 bg-red-100 dark:bg-red-900/20 border border-red-200 dark:border-red-800 rounded-lg">
            <p class="text-red-800 dark:text-red-200 font-semibold">
              ⚠️ This request would have redirected to: {redirectTo}
            </p>
            <p class="text-red-700 dark:text-red-300 text-sm mt-1">
              But we're showing this page instead for demonstration purposes.
            </p>
          </div>
        )}
      </div>

      <!-- Interactive Demo -->
      <div class="bg-white dark:bg-gray-800 rounded-xl p-8 mb-8">
        <h3 class="text-xl font-semibold mb-6 text-gray-900 dark:text-white">Try Custom Redirect</h3>
        <form class="space-y-4">
          <div>
            <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
              Redirect to:
            </label>
            <select 
              id="redirectSelect" 
              class="w-full px-4 py-3 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-orange-500 focus:border-orange-500 dark:bg-gray-700 dark:text-white"
            >
              <option value="/apps/router/static-example">Static Example Page</option>
              <option value="/apps/router/dynamic-example">Dynamic Example Page</option>
              <option value="/apps/router/pets/dog/buddy">Dog Pet Profile</option>
              <option value="/apps/router/blog/create">Blog Creation</option>
              <option value="https://docs.astro.build">Astro Docs (External)</option>
            </select>
          </div>
          <button 
            type="button"
            onclick="window.location.href = '/apps/router/redirect-demo?redirect=true&to=' + document.getElementById('redirectSelect').value"
            class="w-full px-6 py-3 bg-orange-600 text-white rounded-lg hover:bg-orange-700 transition-colors font-medium"
          >
            Test Redirect
          </button>
        </form>
      </div>

      <!-- Status Codes -->
      <div class="bg-gray-50 dark:bg-gray-700 rounded-xl p-8 mb-8">
        <h3 class="text-xl font-semibold mb-6 text-gray-900 dark:text-white">HTTP Redirect Status Codes</h3>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="space-y-3">
            <h4 class="font-semibold text-gray-900 dark:text-white">Temporary Redirects</h4>
            <div class="space-y-2 text-sm">
              <div class="flex items-center">
                <span class="bg-blue-500 text-white px-2 py-1 rounded text-xs font-mono mr-3">302</span>
                <span class="text-gray-600 dark:text-gray-400">Found (default)</span>
              </div>
              <div class="flex items-center">
                <span class="bg-blue-500 text-white px-2 py-1 rounded text-xs font-mono mr-3">307</span>
                <span class="text-gray-600 dark:text-gray-400">Temporary Redirect</span>
              </div>
            </div>
          </div>
          <div class="space-y-3">
            <h4 class="font-semibold text-gray-900 dark:text-white">Permanent Redirects</h4>
            <div class="space-y-2 text-sm">
              <div class="flex items-center">
                <span class="bg-green-500 text-white px-2 py-1 rounded text-xs font-mono mr-3">301</span>
                <span class="text-gray-600 dark:text-gray-400">Moved Permanently</span>
              </div>
              <div class="flex items-center">
                <span class="bg-green-500 text-white px-2 py-1 rounded text-xs font-mono mr-3">308</span>
                <span class="text-gray-600 dark:text-gray-400">Permanent Redirect</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Navigation -->
      <div class="text-center">
        <a 
          href="/apps/router" 
          class="inline-flex items-center px-6 py-3 bg-orange-600 text-white rounded-lg hover:bg-orange-700 transition-colors"
        >
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
          </svg>
          Back to Router Examples
        </a>
      </div>
    </div>
  </main>
</Layout>