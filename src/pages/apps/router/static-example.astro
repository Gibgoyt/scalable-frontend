---
import Layout from 'src/layouts/Layout.astro';

// Force SSG - this page will be pre-rendered at build time
export const prerender = true;

const staticData = {
  title: "Static Route Example (SSG)",
  description: "This page is pre-rendered at build time for maximum performance",
  buildTime: new Date().toISOString(),
  loadTime: "< 50ms",
  seo: "Excellent",
  features: [
    "Pre-rendered HTML",
    "Instant loading",
    "Perfect SEO",
    "CDN-friendly",
    "Zero JavaScript required"
  ]
};
---

<Layout title={staticData.title}>
  <main class="min-h-screen bg-gradient-to-br from-green-50 to-emerald-100 dark:from-green-900/20 dark:to-emerald-900/20">
    <div class="max-w-4xl mx-auto px-4 py-16">
      <!-- Header -->
      <div class="text-center mb-12">
        <div class="inline-flex items-center justify-center w-16 h-16 bg-green-500 rounded-full mb-6">
          <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
          </svg>
        </div>
        <h1 class="text-4xl font-bold mb-4">{staticData.title}</h1>
        <p class="text-xl text-gray-600 dark:text-gray-300">{staticData.description}</p>
      </div>

      <!-- Performance Metrics -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12">
        <div class="bg-white dark:bg-gray-800 rounded-lg p-6 text-center">
          <div class="text-3xl font-bold text-green-600 mb-2">{staticData.loadTime}</div>
          <div class="text-gray-600 dark:text-gray-400">Load Time</div>
        </div>
        <div class="bg-white dark:bg-gray-800 rounded-lg p-6 text-center">
          <div class="text-3xl font-bold text-green-600 mb-2">{staticData.seo}</div>
          <div class="text-gray-600 dark:text-gray-400">SEO Score</div>
        </div>
        <div class="bg-white dark:bg-gray-800 rounded-lg p-6 text-center">
          <div class="text-3xl font-bold text-green-600 mb-2">100%</div>
          <div class="text-gray-600 dark:text-gray-400">Cacheable</div>
        </div>
      </div>

      <!-- Features -->
      <div class="bg-white dark:bg-gray-800 rounded-xl p-8 mb-12">
        <h2 class="text-2xl font-bold mb-6">SSG Features</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {staticData.features.map((feature) => (
            <div class="flex items-center space-x-3">
              <svg class="w-5 h-5 text-green-500" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
              </svg>
              <span>{feature}</span>
            </div>
          ))}
        </div>
      </div>

      <!-- Code Example -->
      <div class="bg-gray-900 rounded-xl p-6 mb-12">
        <h3 class="text-lg font-semibold text-white mb-4">Implementation</h3>
        <pre class="text-sm text-gray-300 overflow-x-auto"><code>{`---
// Force SSG - this page will be pre-rendered at build time
export const prerender = true;

const staticData = {
  title: "Static Route Example (SSG)",
  loadTime: "< 50ms",
  seo: "Excellent"
};
---

<Layout title={staticData.title}>
  <h1>{staticData.title}</h1>
  <p>This content is generated at build time!</p>
</Layout>`}</code></pre>
      </div>

      <!-- Build Information -->
      <div class="bg-green-50 dark:bg-green-900/20 rounded-lg p-6 border border-green-200 dark:border-green-800">
        <h3 class="font-semibold text-green-800 dark:text-green-200 mb-2">Build Information</h3>
        <p class="text-green-700 dark:text-green-300 text-sm">
          This page was pre-rendered at build time: <strong>{staticData.buildTime}</strong>
        </p>
        <p class="text-green-700 dark:text-green-300 text-sm mt-2">
          Every visitor sees the same HTML, served instantly from CDN.
        </p>
      </div>

      <!-- Navigation -->
      <div class="mt-12 text-center">
        <a 
          href="/apps/router" 
          class="inline-flex items-center px-6 py-3 bg-green-600 text-white rounded-lg hover:bg-green-700 transition-colors"
        >
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
          </svg>
          Back to Router Examples
        </a>
      </div>
    </div>
  </main>
</Layout>