---
import Layout from 'src/layouts/Layout.astro';

export const prerender = false;

const { slug } = Astro.params;

// Mock blog posts database
const blogPosts = {
  'my-first-post': {
    title: 'My First Blog Post',
    content: 'This is my very first blog post using Astro\'s dynamic routing!',
    author: 'John Doe',
    publishedAt: '2024-01-15',
    tags: ['astro', 'routing', 'demo'],
    category: 'tech',
    readTime: 3
  },
  'astro-routing-guide': {
    title: 'Complete Guide to Astro Routing',
    content: 'Learn everything about Astro\'s powerful file-based routing system.',
    author: 'Jane Smith',
    publishedAt: '2024-01-20',
    tags: ['astro', 'routing', 'tutorial'],
    category: 'tech',
    readTime: 8
  },
  'dynamic-vs-static': {
    title: 'Dynamic vs Static Routes in Astro',
    content: 'Understanding when to use SSG vs SSR in your Astro applications.',
    author: 'Alex Johnson',
    publishedAt: '2024-01-22',
    tags: ['astro', 'ssg', 'ssr', 'performance'],
    category: 'tech',
    readTime: 6
  },
  'web-performance-tips': {
    title: '10 Web Performance Tips for 2024',
    content: 'Boost your website speed with these proven optimization techniques.',
    author: 'Sarah Wilson',
    publishedAt: '2024-01-25',
    tags: ['performance', 'optimization', 'web'],
    category: 'tech',
    readTime: 12
  }
};

// Get the blog post or show not found
const post = blogPosts[slug || ''];

if (!post && slug !== 'my-first-post') {
  // For demo purposes, create a generic post for any unknown slug
  const mockPost = {
    title: `Blog Post: ${slug?.split('-').map(word => word.charAt(0).toUpperCase() + word.slice(1)).join(' ')}`,
    content: `This is a dynamically generated blog post for the slug "${slug}". In a real application, this would come from your CMS or database.`,
    author: 'Demo Author',
    publishedAt: new Date().toISOString().split('T')[0],
    tags: ['demo', 'dynamic', 'routing'],
    category: 'tech',
    readTime: 5
  };
  
  const pageTitle = `${mockPost.title} - Blog`;
} else if (post) {
  const pageTitle = `${post.title} - Blog`;
}

const currentPost = post || {
  title: `Blog Post: ${slug?.split('-').map(word => word.charAt(0).toUpperCase() + word.slice(1)).join(' ')}`,
  content: `This is a dynamically generated blog post for the slug "${slug}". In a real application, this would come from your CMS or database.`,
  author: 'Demo Author',
  publishedAt: new Date().toISOString().split('T')[0],
  tags: ['demo', 'dynamic', 'routing'],
  category: 'tech',
  readTime: 5
};

const pageTitle = `${currentPost.title} - Blog`;
---

<Layout title={pageTitle}>
  <main class="min-h-screen bg-gradient-to-br from-blue-50 to-indigo-100 dark:from-blue-900/20 dark:to-indigo-900/20">
    <div class="max-w-4xl mx-auto px-4 py-16">
      <!-- Header -->
      <div class="text-center mb-12">
        <div class="inline-flex items-center justify-center w-16 h-16 bg-blue-500 rounded-full mb-6">
          <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
          </svg>
        </div>
        <h1 class="text-4xl font-bold mb-4">{currentPost.title}</h1>
        <div class="flex items-center justify-center space-x-6 text-sm text-gray-600 dark:text-gray-400">
          <span>By {currentPost.author}</span>
          <span>•</span>
          <span>{currentPost.publishedAt}</span>
          <span>•</span>
          <span>{currentPost.readTime} min read</span>
        </div>
      </div>

      <!-- Route Information -->
      <div class="bg-blue-50 dark:bg-blue-900/20 rounded-xl p-6 mb-8 border border-blue-200 dark:border-blue-800">
        <h2 class="text-lg font-semibold text-blue-800 dark:text-blue-200 mb-4">Dynamic Route Details</h2>
        <div class="space-y-3 text-sm">
          <div>
            <span class="font-semibold">File:</span>
            <code class="ml-2 bg-white dark:bg-gray-800 px-2 py-1 rounded font-mono">
              /blog/[slug].astro (dynamic route)
            </code>
          </div>
          <div>
            <span class="font-semibold">URL Pattern:</span>
            <code class="ml-2 bg-white dark:bg-gray-800 px-2 py-1 rounded font-mono">
              /blog/[any-slug-here]
            </code>
          </div>
          <div>
            <span class="font-semibold">Current slug:</span>
            <code class="ml-2 bg-white dark:bg-gray-800 px-2 py-1 rounded font-mono">
              "{slug}"
            </code>
          </div>
          <div>
            <span class="font-semibold">Note:</span>
            <span class="ml-2 text-blue-700 dark:text-blue-300">
              This route handles all /blog/* URLs except /blog/create (static route has priority)
            </span>
          </div>
        </div>
      </div>

      <!-- Blog Content -->
      <article class="bg-white dark:bg-gray-800 rounded-xl shadow-lg p-8 mb-8">
        <!-- Tags -->
        <div class="flex flex-wrap gap-2 mb-6">
          {currentPost.tags.map((tag) => (
            <span class="px-3 py-1 bg-blue-100 dark:bg-blue-900/20 text-blue-700 dark:text-blue-300 rounded-full text-sm">
              #{tag}
            </span>
          ))}
        </div>

        <!-- Content -->
        <div class="prose dark:prose-invert max-w-none">
          <p class="text-lg leading-relaxed">{currentPost.content}</p>
          
          {!post && (
            <div class="mt-8 p-6 bg-yellow-50 dark:bg-yellow-900/20 border border-yellow-200 dark:border-yellow-800 rounded-lg">
              <h3 class="font-semibold text-yellow-800 dark:text-yellow-200 mb-2">Demo Note</h3>
              <p class="text-yellow-700 dark:text-yellow-300 text-sm">
                This blog post was dynamically generated because no specific content exists for the slug "{slug}". 
                In a real application, you would typically:
              </p>
              <ul class="list-disc list-inside text-yellow-700 dark:text-yellow-300 text-sm mt-3 space-y-1">
                <li>Query your database or CMS for content matching this slug</li>
                <li>Return a 404 page if no content is found</li>
                <li>Or redirect to a similar/related post</li>
              </ul>
            </div>
          )}
        </div>
      </article>

      <!-- Related Posts -->
      <div class="bg-white dark:bg-gray-800 rounded-xl p-8 mb-8">
        <h3 class="text-xl font-semibold mb-6">Other Blog Posts</h3>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {Object.entries(blogPosts).filter(([key]) => key !== slug).slice(0, 4).map(([postSlug, postData]) => (
            <a 
              href={`/apps/router/blog/${postSlug}`}
              class="block p-4 bg-gray-50 dark:bg-gray-700 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-600 transition-colors"
            >
              <h4 class="font-semibold mb-2">{postData.title}</h4>
              <div class="text-sm text-gray-600 dark:text-gray-400">
                {postData.author} • {postData.readTime} min read
              </div>
            </a>
          ))}
        </div>
      </div>

      <!-- Route Priority Demo -->
      <div class="bg-gradient-to-r from-blue-50 to-purple-50 dark:from-blue-900/20 dark:to-purple-900/20 rounded-xl p-8 mb-8">
        <h3 class="text-xl font-semibold mb-6">Route Priority in Action</h3>
        <div class="space-y-4">
          <div class="p-4 bg-white dark:bg-gray-800 rounded-lg">
            <div class="flex items-center justify-between">
              <code class="font-mono text-sm">/blog/create</code>
              <span class="px-3 py-1 bg-green-100 dark:bg-green-900/20 text-green-700 dark:text-green-300 rounded-full text-sm">
                Static Route
              </span>
            </div>
            <p class="text-sm text-gray-600 dark:text-gray-400 mt-2">
              Goes to create.astro (blog creation form)
            </p>
          </div>
          
          <div class="p-4 bg-white dark:bg-gray-800 rounded-lg">
            <div class="flex items-center justify-between">
              <code class="font-mono text-sm">/blog/{slug}</code>
              <span class="px-3 py-1 bg-blue-100 dark:bg-blue-900/20 text-blue-700 dark:text-blue-300 rounded-full text-sm">
                Dynamic Route
              </span>
            </div>
            <p class="text-sm text-gray-600 dark:text-gray-400 mt-2">
              Goes to [slug].astro (this page)
            </p>
          </div>
        </div>
      </div>

      <!-- Code Example -->
      <div class="bg-gray-900 rounded-xl p-6 mb-8">
        <h3 class="text-lg font-semibold text-white mb-4">Dynamic Route Implementation</h3>
        <pre class="text-sm text-gray-300 overflow-x-auto"><code>{`---
// File: /blog/[slug].astro
export const prerender = false; // SSR for dynamic content

const { slug } = Astro.params;

// In real app: query database/CMS
const post = await getPostBySlug(slug);

if (!post) {
  return Astro.redirect('/404');
}
---

<Layout title={post.title}>
  <h1>{post.title}</h1>
  <p>Slug: {slug}</p>
  <div>{post.content}</div>
</Layout>`}</code></pre>
      </div>

      <!-- Test Different Slugs -->
      <div class="bg-gray-50 dark:bg-gray-700 rounded-xl p-8 mb-8">
        <h3 class="text-xl font-semibold mb-6">Test Different Slugs</h3>
        <p class="text-gray-600 dark:text-gray-400 mb-4">
          Try these URLs to see how the dynamic route handles different slugs:
        </p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a 
            href="/apps/router/blog/test-post" 
            class="block p-3 bg-blue-100 dark:bg-blue-900/20 text-blue-700 dark:text-blue-300 rounded-lg hover:bg-blue-200 dark:hover:bg-blue-900/40 transition-colors text-center"
          >
            /blog/test-post
          </a>
          <a 
            href="/apps/router/blog/another-example" 
            class="block p-3 bg-blue-100 dark:bg-blue-900/20 text-blue-700 dark:text-blue-300 rounded-lg hover:bg-blue-200 dark:hover:bg-blue-900/40 transition-colors text-center"
          >
            /blog/another-example
          </a>
          <a 
            href="/apps/router/blog/dynamic-routing-demo" 
            class="block p-3 bg-blue-100 dark:bg-blue-900/20 text-blue-700 dark:text-blue-300 rounded-lg hover:bg-blue-200 dark:hover:bg-blue-900/40 transition-colors text-center"
          >
            /blog/dynamic-routing-demo
          </a>
          <a 
            href="/apps/router/blog/any-slug-works" 
            class="block p-3 bg-blue-100 dark:bg-blue-900/20 text-blue-700 dark:text-blue-300 rounded-lg hover:bg-blue-200 dark:hover:bg-blue-900/40 transition-colors text-center"
          >
            /blog/any-slug-works
          </a>
        </div>
      </div>

      <!-- Navigation -->
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <button 
          onclick="window.history.back()"
          class="inline-flex items-center justify-center px-6 py-3 bg-gray-600 text-white rounded-lg hover:bg-gray-700 transition-colors"
        >
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
          </svg>
          Go Back
        </button>
        <a 
          href="/apps/router/blog/create"
          class="inline-flex items-center justify-center px-6 py-3 bg-emerald-600 text-white rounded-lg hover:bg-emerald-700 transition-colors"
        >
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"></path>
          </svg>
          Create New Post
        </a>
        <a 
          href="/apps/router" 
          class="inline-flex items-center justify-center px-6 py-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors"
        >
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
          </svg>
          Back to Router Examples
        </a>
      </div>
    </div>
  </main>
</Layout>