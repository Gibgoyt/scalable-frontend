---
import Layout from 'src/layouts/Layout.astro';

// This is a static route - it will take priority over [slug].astro
export const prerender = true;

const formData = {
  title: '',
  content: '',
  tags: '',
  category: 'tech'
};
---

<Layout title="Create Blog Post - Router Demo">
  <main class="min-h-screen bg-gradient-to-br from-emerald-50 to-teal-100 dark:from-emerald-900/20 dark:to-teal-900/20">
    <div class="max-w-4xl mx-auto px-4 py-16">
      <!-- Header -->
      <div class="text-center mb-12">
        <div class="inline-flex items-center justify-center w-16 h-16 bg-emerald-500 rounded-full mb-6">
          <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"></path>
          </svg>
        </div>
        <h1 class="text-4xl font-bold mb-4">Create New Blog Post</h1>
        <p class="text-xl text-gray-600 dark:text-gray-300">Static Route Priority Example</p>
      </div>

      <!-- Route Priority Explanation -->
      <div class="bg-emerald-50 dark:bg-emerald-900/20 rounded-xl p-6 mb-8 border border-emerald-200 dark:border-emerald-800">
        <h2 class="text-lg font-semibold text-emerald-800 dark:text-emerald-200 mb-4">Route Priority Demonstration</h2>
        <div class="space-y-3 text-sm">
          <div>
            <span class="font-semibold">This file:</span>
            <code class="ml-2 bg-white dark:bg-gray-800 px-2 py-1 rounded font-mono">
              /blog/create.astro (static route)
            </code>
          </div>
          <div>
            <span class="font-semibold">Also exists:</span>
            <code class="ml-2 bg-white dark:bg-gray-800 px-2 py-1 rounded font-mono">
              /blog/[slug].astro (dynamic route)
            </code>
          </div>
          <div>
            <span class="font-semibold">URL:</span>
            <code class="ml-2 bg-white dark:bg-gray-800 px-2 py-1 rounded font-mono">
              /blog/create
            </code>
          </div>
          <div class="text-emerald-700 dark:text-emerald-300">
            ✅ <strong>Static route wins!</strong> Even though /blog/[slug].astro could match "create", 
            the static route takes priority.
          </div>
        </div>
      </div>

      <!-- Blog Creation Form -->
      <div class="bg-white dark:bg-gray-800 rounded-xl shadow-lg p-8 mb-8">
        <form class="space-y-6">
          <div>
            <label for="title" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
              Blog Post Title
            </label>
            <input 
              type="text" 
              id="title" 
              name="title"
              placeholder="Enter your blog post title..."
              class="w-full px-4 py-3 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 dark:bg-gray-700 dark:text-white"
              required
            />
          </div>

          <div>
            <label for="category" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
              Category
            </label>
            <select 
              id="category" 
              name="category"
              class="w-full px-4 py-3 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 dark:bg-gray-700 dark:text-white"
            >
              <option value="tech">Technology</option>
              <option value="lifestyle">Lifestyle</option>
              <option value="travel">Travel</option>
              <option value="food">Food</option>
              <option value="business">Business</option>
            </select>
          </div>

          <div>
            <label for="tags" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
              Tags (comma-separated)
            </label>
            <input 
              type="text" 
              id="tags" 
              name="tags"
              placeholder="astro, routing, demo, web-development"
              class="w-full px-4 py-3 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 dark:bg-gray-700 dark:text-white"
            />
          </div>

          <div>
            <label for="content" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
              Content
            </label>
            <textarea 
              id="content" 
              name="content"
              rows="10"
              placeholder="Write your blog post content here..."
              class="w-full px-4 py-3 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 dark:bg-gray-700 dark:text-white"
              required
            ></textarea>
          </div>

          <div class="flex items-center space-x-4">
            <button 
              type="submit"
              class="px-6 py-3 bg-emerald-600 text-white rounded-lg hover:bg-emerald-700 transition-colors font-medium"
            >
              Create Blog Post
            </button>
            <button 
              type="button"
              class="px-6 py-3 bg-gray-200 dark:bg-gray-600 text-gray-700 dark:text-gray-300 rounded-lg hover:bg-gray-300 dark:hover:bg-gray-500 transition-colors font-medium"
            >
              Save Draft
            </button>
          </div>
        </form>
      </div>

      <!-- Priority Rules -->
      <div class="bg-white dark:bg-gray-800 rounded-xl p-8 mb-8">
        <h3 class="text-xl font-semibold mb-6">Astro Route Priority Rules</h3>
        <div class="space-y-4">
          <div class="flex items-start space-x-4 p-4 bg-green-50 dark:bg-green-900/20 rounded-lg">
            <div class="flex-shrink-0 w-8 h-8 bg-green-500 text-white rounded-full flex items-center justify-center font-bold text-sm">
              1
            </div>
            <div>
              <h4 class="font-semibold text-green-800 dark:text-green-200">Static Routes</h4>
              <p class="text-green-700 dark:text-green-300 text-sm">
                <code class="bg-white dark:bg-gray-800 px-1 rounded">/blog/create.astro</code> - 
                Exact path matches, no parameters
              </p>
            </div>
          </div>

          <div class="flex items-start space-x-4 p-4 bg-blue-50 dark:bg-blue-900/20 rounded-lg">
            <div class="flex-shrink-0 w-8 h-8 bg-blue-500 text-white rounded-full flex items-center justify-center font-bold text-sm">
              2
            </div>
            <div>
              <h4 class="font-semibold text-blue-800 dark:text-blue-200">Dynamic Routes (Named Params)</h4>
              <p class="text-blue-700 dark:text-blue-300 text-sm">
                <code class="bg-white dark:bg-gray-800 px-1 rounded">/blog/[slug].astro</code> - 
                Single parameter matches
              </p>
            </div>
          </div>

          <div class="flex items-start space-x-4 p-4 bg-purple-50 dark:bg-purple-900/20 rounded-lg">
            <div class="flex-shrink-0 w-8 h-8 bg-purple-500 text-white rounded-full flex items-center justify-center font-bold text-sm">
              3
            </div>
            <div>
              <h4 class="font-semibold text-purple-800 dark:text-purple-200">Rest Parameter Routes</h4>
              <p class="text-purple-700 dark:text-purple-300 text-sm">
                <code class="bg-white dark:bg-gray-800 px-1 rounded">/blog/[...path].astro</code> - 
                Catch-all for any depth
              </p>
            </div>
          </div>
        </div>
      </div>

      <!-- Test Links -->
      <div class="bg-gray-50 dark:bg-gray-700 rounded-xl p-8 mb-8">
        <h3 class="text-xl font-semibold mb-6">Test Route Priority</h3>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <h4 class="font-semibold mb-3">Static Route (Higher Priority)</h4>
            <a 
              href="/apps/router/blog/create" 
              class="block p-3 bg-emerald-100 dark:bg-emerald-900/20 text-emerald-700 dark:text-emerald-300 rounded-lg hover:bg-emerald-200 dark:hover:bg-emerald-900/40 transition-colors"
            >
              📝 /blog/create → This page (create.astro)
            </a>
          </div>
          <div>
            <h4 class="font-semibold mb-3">Dynamic Route (Lower Priority)</h4>
            <a 
              href="/apps/router/blog/my-first-post" 
              class="block p-3 bg-blue-100 dark:bg-blue-900/20 text-blue-700 dark:text-blue-300 rounded-lg hover:bg-blue-200 dark:hover:bg-blue-900/40 transition-colors"
            >
              📄 /blog/my-first-post → [slug].astro
            </a>
          </div>
        </div>
        <p class="text-sm text-gray-600 dark:text-gray-400 mt-4">
          Notice how /blog/create goes to this page instead of treating "create" as a slug!
        </p>
      </div>

      <!-- Code Example -->
      <div class="bg-gray-900 rounded-xl p-6 mb-8">
        <h3 class="text-lg font-semibold text-white mb-4">Implementation</h3>
        <pre class="text-sm text-gray-300 overflow-x-auto"><code>{`// File structure:
pages/
  blog/
    create.astro         ← Static route (higher priority)
    [slug].astro         ← Dynamic route (lower priority)
    [...path].astro      ← Rest param route (lowest priority)

// URL: /blog/create
// Result: create.astro is served (static wins over dynamic)

// URL: /blog/my-post  
// Result: [slug].astro is served with slug="my-post"

// URL: /blog/category/tech/post-1
// Result: [...path].astro is served with path="category/tech/post-1"`}</code></pre>
      </div>

      <!-- Navigation -->
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <button 
          onclick="window.history.back()"
          class="inline-flex items-center justify-center px-6 py-3 bg-gray-600 text-white rounded-lg hover:bg-gray-700 transition-colors"
        >
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
          </svg>
          Go Back
        </button>
        <a 
          href="/apps/router" 
          class="inline-flex items-center justify-center px-6 py-3 bg-emerald-600 text-white rounded-lg hover:bg-emerald-700 transition-colors"
        >
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
          </svg>
          Back to Router Examples
        </a>
      </div>
    </div>
  </main>
</Layout>