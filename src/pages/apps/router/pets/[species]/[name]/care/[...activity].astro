---
import Layout from 'src/layouts/Layout.astro';

export const prerender = false;

const { species, name, activity } = Astro.params;

// Parse the activity path (rest parameter)
const activityPath = activity || '';
const activityParts = activityPath.split('/').filter(Boolean);
const currentActivity = activityParts[0] || 'general';
const subActivity = activityParts[1] || null;

// Mock pet data (simplified)
const pets = {
  'dog-buddy': { name: 'Buddy', species: 'dog', image: '🐕' },
  'cat-whiskers': { name: 'Whiskers', species: 'cat', image: '🐱' },
  'bird-tweety': { name: 'Tweety', species: 'bird', image: '🐦' }
};

const petKey = `${species}-${name?.toLowerCase()}`;
const pet = pets[petKey];

if (!pet) {
  return Astro.redirect('/apps/router/pets-not-found');
}

// Care activity data
const careActivities = {
  feeding: {
    title: 'Feeding Time',
    description: 'Nutritional care and feeding schedule',
    icon: '🍽️',
    steps: ['Check food bowl', 'Measure appropriate portion', 'Provide fresh water', 'Monitor eating habits'],
    subActivities: ['breakfast', 'lunch', 'dinner', 'treats']
  },
  grooming: {
    title: 'Grooming Session',
    description: 'Keeping your pet clean and healthy',
    icon: '🧼',
    steps: ['Brush fur/feathers', 'Check for parasites', 'Clean ears', 'Trim nails if needed'],
    subActivities: ['brushing', 'bathing', 'nail-trimming', 'ear-cleaning']
  },
  playing: {
    title: 'Play Time',
    description: 'Fun activities and exercise',
    icon: '🎾',
    steps: ['Prepare toys', 'Ensure safe space', 'Engage actively', 'Cool down period'],
    subActivities: ['fetch', 'tug-of-war', 'hide-and-seek', 'puzzle-games']
  },
  walking: {
    title: 'Walking Exercise',
    description: 'Outdoor exercise and exploration',
    icon: '🚶',
    steps: ['Attach leash', 'Check weather', 'Choose route', 'Monitor pet behavior'],
    subActivities: ['morning-walk', 'evening-walk', 'park-visit', 'training-walk']
  },
  training: {
    title: 'Training Session',
    description: 'Teaching commands and behaviors',
    icon: '🎯',
    steps: ['Prepare treats', 'Start with basics', 'Practice commands', 'Reward progress'],
    subActivities: ['sit', 'stay', 'come', 'heel']
  }
};

const activityData = careActivities[currentActivity] || {
  title: 'General Care',
  description: 'Basic pet care activity',
  icon: '💝',
  steps: ['Assess pet needs', 'Prepare necessary items', 'Perform care activity', 'Monitor results'],
  subActivities: []
};

const pageTitle = `${pet.name} - ${activityData.title}${subActivity ? ` - ${subActivity}` : ''}`;
---

<Layout title={pageTitle}>
  <main class="min-h-screen bg-gradient-to-br from-amber-50 to-orange-100 dark:from-amber-900/20 dark:to-orange-900/20">
    <div class="max-w-4xl mx-auto px-4 py-16">
      <!-- Breadcrumb -->
      <nav class="mb-8">
        <ol class="flex items-center space-x-2 text-sm text-gray-600 dark:text-gray-400">
          <li><a href="/apps/router" class="hover:text-amber-600">Router</a></li>
          <li class="before:content-['/'] before:mx-2">
            <a href={`/apps/router/pets/${species}/${name}`} class="hover:text-amber-600">
              {pet.name}
            </a>
          </li>
          <li class="before:content-['/'] before:mx-2">Care</li>
          <li class="before:content-['/'] before:mx-2 font-semibold text-amber-600 dark:text-amber-400">
            {currentActivity}
          </li>
          {subActivity && (
            <li class="before:content-['/'] before:mx-2 font-semibold text-amber-700 dark:text-amber-300">
              {subActivity}
            </li>
          )}
        </ol>
      </nav>

      <!-- Header -->
      <div class="text-center mb-12">
        <div class="flex items-center justify-center mb-4">
          <span class="text-6xl mr-4">{pet.image}</span>
          <span class="text-6xl">{activityData.icon}</span>
        </div>
        <h1 class="text-4xl font-bold mb-2">
          {pet.name}'s {activityData.title}
          {subActivity && <span class="text-amber-600"> - {subActivity}</span>}
        </h1>
        <p class="text-xl text-gray-600 dark:text-gray-300">{activityData.description}</p>
      </div>

      <!-- Route Information -->
      <div class="bg-amber-50 dark:bg-amber-900/20 rounded-xl p-6 mb-8 border border-amber-200 dark:border-amber-800">
        <h2 class="text-lg font-semibold text-amber-800 dark:text-amber-200 mb-4">Rest Parameter Route</h2>
        <div class="space-y-3 text-sm">
          <div>
            <span class="font-semibold">File:</span>
            <code class="ml-2 bg-white dark:bg-gray-800 px-2 py-1 rounded font-mono">
              [...activity].astro
            </code>
          </div>
          <div>
            <span class="font-semibold">Full URL:</span>
            <code class="ml-2 bg-white dark:bg-gray-800 px-2 py-1 rounded font-mono">
              /pets/{species}/{name}/care/{activityPath || 'general'}
            </code>
          </div>
          <div>
            <span class="font-semibold">Activity path:</span>
            <code class="ml-2 bg-white dark:bg-gray-800 px-2 py-1 rounded font-mono">
              "{activityPath}" → [{activityParts.map(part => `"${part}"`).join(', ')}]
            </code>
          </div>
          <div>
            <span class="font-semibold">Parsed as:</span>
            <span class="ml-2 text-amber-700 dark:text-amber-300">
              Activity: "{currentActivity}", Sub-activity: "{subActivity || 'none'}"
            </span>
          </div>
        </div>
      </div>

      <!-- Activity Steps -->
      <div class="bg-white dark:bg-gray-800 rounded-xl p-8 mb-8">
        <h2 class="text-2xl font-bold mb-6">Activity Steps</h2>
        <div class="space-y-4">
          {activityData.steps.map((step, index) => (
            <div class="flex items-start space-x-4">
              <div class="flex-shrink-0 w-8 h-8 bg-amber-500 text-white rounded-full flex items-center justify-center font-bold text-sm">
                {index + 1}
              </div>
              <div class="flex-1 pt-1">
                <p>{step}</p>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Sub-Activities -->
      {activityData.subActivities.length > 0 && (
        <div class="bg-white dark:bg-gray-800 rounded-xl p-8 mb-8">
          <h2 class="text-2xl font-bold mb-6 text-gray-900 dark:text-white">Sub-Activities</h2>
          <p class="text-gray-600 dark:text-gray-300 mb-6">
            These demonstrate deeper nested paths with rest parameters:
          </p>
          <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
            {activityData.subActivities.map((subAct) => (
              <a 
                href={`/apps/router/pets/${species}/${name}/care/${currentActivity}/${subAct}`}
                class={`block p-3 rounded-lg text-center transition-colors ${
                  subActivity === subAct 
                    ? 'bg-amber-500 text-white' 
                    : 'bg-amber-100 dark:bg-amber-900/20 text-amber-700 dark:text-amber-300 hover:bg-amber-200 dark:hover:bg-amber-900/40'
                }`}
              >
                {subAct.replace('-', ' ')}
              </a>
            ))}
          </div>
        </div>
      )}

      <!-- Try These URLs Interactive Section -->
      <div class="bg-white dark:bg-gray-800 rounded-xl p-8 mb-8">
        <h2 class="text-2xl font-bold mb-6 text-gray-900 dark:text-white">Try These URLs</h2>
        <p class="text-gray-600 dark:text-gray-300 mb-6">
          Click these buttons to explore different care activities, or create your own URL below:
        </p>
        
        <!-- Quick Links -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3 mb-8">
          <a 
            href={`/apps/router/pets/${species}/${name}/care/feeding/breakfast`}
            class="block p-3 bg-blue-100 dark:bg-blue-900/20 text-blue-700 dark:text-blue-300 rounded-lg hover:bg-blue-200 dark:hover:bg-blue-900/40 transition-colors text-center"
          >
            🍽️ Feeding → Breakfast
          </a>
          <a 
            href={`/apps/router/pets/${species}/${name}/care/grooming/brushing`}
            class="block p-3 bg-green-100 dark:bg-green-900/20 text-green-700 dark:text-green-300 rounded-lg hover:bg-green-200 dark:hover:bg-green-900/40 transition-colors text-center"
          >
            🧼 Grooming → Brushing
          </a>
          <a 
            href={`/apps/router/pets/${species}/${name}/care/playing/fetch`}
            class="block p-3 bg-purple-100 dark:bg-purple-900/20 text-purple-700 dark:text-purple-300 rounded-lg hover:bg-purple-200 dark:hover:bg-purple-900/40 transition-colors text-center"
          >
            🎾 Playing → Fetch
          </a>
          <a 
            href={`/apps/router/pets/${species}/${name}/care/training/sit`}
            class="block p-3 bg-orange-100 dark:bg-orange-900/20 text-orange-700 dark:text-orange-300 rounded-lg hover:bg-orange-200 dark:hover:bg-orange-900/40 transition-colors text-center"
          >
            🎯 Training → Sit
          </a>
          <a 
            href={`/apps/router/pets/${species}/${name}/care/walking/morning-walk`}
            class="block p-3 bg-teal-100 dark:bg-teal-900/20 text-teal-700 dark:text-teal-300 rounded-lg hover:bg-teal-200 dark:hover:bg-teal-900/40 transition-colors text-center"
          >
            🚶 Walking → Morning Walk
          </a>
          <a 
            href={`/apps/router/pets/${species}/${name}/care/deep/nested/path/example`}
            class="block p-3 bg-pink-100 dark:bg-pink-900/20 text-pink-700 dark:text-pink-300 rounded-lg hover:bg-pink-200 dark:hover:bg-pink-900/40 transition-colors text-center"
          >
            🔗 Deep Nested Path
          </a>
        </div>

        <!-- Dynamic URL Creator -->
        <div class="bg-amber-50 dark:bg-amber-900/20 border border-amber-200 dark:border-amber-800 rounded-lg p-6">
          <h3 class="font-semibold text-amber-800 dark:text-amber-200 mb-4">Create Your Own URL</h3>
          <p class="text-amber-700 dark:text-amber-300 text-sm mb-4">
            The rest parameter [...activity] can handle any path depth. Try creating your own URL:
          </p>
          
          <div class="space-y-4">
            <div>
              <label class="block text-sm font-medium text-amber-700 dark:text-amber-300 mb-2">
                Activity Path (use / for nested paths):
              </label>
              <input 
                type="text" 
                id="customActivity"
                placeholder="e.g., feeding/dinner/special-diet/grain-free"
                class="w-full px-4 py-3 border border-amber-300 dark:border-amber-600 rounded-lg focus:ring-2 focus:ring-amber-500 focus:border-amber-500 dark:bg-gray-700 dark:text-white"
              />
            </div>
            
            <button 
              onclick="navigateToCustomActivity()"
              class="w-full px-6 py-3 bg-amber-600 text-white rounded-lg hover:bg-amber-700 transition-colors font-medium"
            >
              Go to Custom Activity
            </button>
            
            <div class="text-xs text-amber-600 dark:text-amber-400">
              <strong>Examples to try:</strong><br/>
              • feeding/dinner/special-diet<br/>
              • grooming/full-service/nail-trimming/front-paws<br/>
              • playing/outdoor/park/fetch/tennis-ball
            </div>
          </div>
        </div>
      </div>

      <script>
        function navigateToCustomActivity() {
          const input = document.getElementById('customActivity');
          const activity = input.value.trim();
          if (activity) {
            const cleanActivity = activity.replace(/^\/+|\/+$/g, ''); // Remove leading/trailing slashes
            window.location.href = `/apps/router/pets/${species}/${name}/care/${cleanActivity}`;
          } else {
            alert('Please enter an activity path!');
          }
        }
        
        // Allow Enter key to submit
        document.getElementById('customActivity').addEventListener('keypress', function(e) {
          if (e.key === 'Enter') {
            navigateToCustomActivity();
          }
        });
      </script>

      <!-- Current Status -->
      <div class="bg-gradient-to-r from-green-50 to-emerald-50 dark:from-green-900/20 dark:to-emerald-900/20 rounded-xl p-8 mb-8">
        <h2 class="text-2xl font-bold mb-4">Activity Status</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <div class="text-center">
            <div class="text-3xl mb-2">⏰</div>
            <div class="font-semibold">Started</div>
            <div class="text-sm text-gray-600 dark:text-gray-400">Just now</div>
          </div>
          <div class="text-center">
            <div class="text-3xl mb-2">📊</div>
            <div class="font-semibold">Progress</div>
            <div class="text-sm text-gray-600 dark:text-gray-400">In progress</div>
          </div>
          <div class="text-center">
            <div class="text-3xl mb-2">💝</div>
            <div class="font-semibold">Pet Mood</div>
            <div class="text-sm text-gray-600 dark:text-gray-400">Happy</div>
          </div>
        </div>
      </div>

      <!-- Code Example -->
      <div class="bg-gray-900 rounded-xl p-6 mb-8">
        <h3 class="text-lg font-semibold text-white mb-4">Rest Parameter Implementation</h3>
        <pre class="text-sm text-gray-300 overflow-x-auto"><code>{`---
// File: /pets/[species]/[name]/care/[...activity].astro
const { species, name, activity } = Astro.params;

// Parse rest parameter into parts
const activityPath = activity || '';
const activityParts = activityPath.split('/').filter(Boolean);
const currentActivity = activityParts[0] || 'general';
const subActivity = activityParts[1] || null;

// This route matches:
// /pets/dog/buddy/care/feeding
// /pets/dog/buddy/care/feeding/breakfast
// /pets/dog/buddy/care/grooming/brushing
// /pets/dog/buddy/care/any/deep/nested/path
---

<h1>{pet.name}'s {currentActivity}</h1>`}</code></pre>
      </div>

      <!-- Example URLs -->
      <div class="bg-blue-50 dark:bg-blue-900/20 rounded-lg p-6 mb-8 border border-blue-200 dark:border-blue-800">
        <h3 class="font-semibold text-blue-800 dark:text-blue-200 mb-4">Try These URLs</h3>
        <div class="space-y-2 text-sm">
          <div>
            <code class="bg-white dark:bg-gray-800 px-2 py-1 rounded">/pets/dog/buddy/care/feeding</code>
            <span class="ml-2 text-blue-600 dark:text-blue-400">→ Basic feeding activity</span>
          </div>
          <div>
            <code class="bg-white dark:bg-gray-800 px-2 py-1 rounded">/pets/dog/buddy/care/feeding/breakfast</code>
            <span class="ml-2 text-blue-600 dark:text-blue-400">→ Specific meal time</span>
          </div>
          <div>
            <code class="bg-white dark:bg-gray-800 px-2 py-1 rounded">/pets/dog/buddy/care/training/sit</code>
            <span class="ml-2 text-blue-600 dark:text-blue-400">→ Specific training command</span>
          </div>
        </div>
      </div>

      <!-- Navigation -->
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a 
          href={`/apps/router/pets/${species}/${name}`}
          class="inline-flex items-center justify-center px-6 py-3 bg-amber-600 text-white rounded-lg hover:bg-amber-700 transition-colors"
        >
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
          </svg>
          Back to {pet.name}'s Profile
        </a>
        <a 
          href="/apps/router" 
          class="inline-flex items-center justify-center px-6 py-3 bg-gray-600 text-white rounded-lg hover:bg-gray-700 transition-colors"
        >
          Back to Router Examples
        </a>
      </div>
    </div>
  </main>
</Layout>