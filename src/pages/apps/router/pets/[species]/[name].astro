---
import Layout from 'src/layouts/Layout.astro';

// This is an SSR route - no prerender
export const prerender = false;

const { species, name } = Astro.params;

// Mock pet database
const petDatabase = {
  'dog-buddy': {
    species: 'dog',
    name: 'Buddy',
    breed: 'Golden Retriever',
    age: 3,
    personality: ['Friendly', 'Energetic', 'Loyal'],
    favoriteActivities: ['Fetch', 'Swimming', 'Belly rubs'],
    health: 'Excellent',
    lastVisit: '2024-01-15',
    image: '🐕'
  },
  'cat-whiskers': {
    species: 'cat',
    name: 'Whiskers',
    breed: 'Persian',
    age: 5,
    personality: ['Independent', 'Curious', 'Affectionate'],
    favoriteActivities: ['Napping', 'Hunting toys', 'Window watching'],
    health: 'Good',
    lastVisit: '2024-01-10',
    image: '🐱'
  },
  'bird-tweety': {
    species: 'bird',
    name: 'Tweety',
    breed: 'Canary',
    age: 2,
    personality: ['Cheerful', 'Vocal', 'Social'],
    favoriteActivities: ['Singing', 'Flying', 'Eating seeds'],
    health: 'Excellent',
    lastVisit: '2024-01-20',
    image: '🐦'
  }
};

// Create pet key for lookup
const petKey = `${species}-${name?.toLowerCase()}`;
const pet = petDatabase[petKey];

// If pet not found, we could redirect or show 404
if (!pet) {
  return Astro.redirect('/apps/router/pets-not-found');
}

// Generate care activities based on species
const careActivities = species === 'dog' 
  ? ['feeding', 'walking', 'grooming', 'playing', 'training']
  : species === 'cat'
  ? ['feeding', 'litter-cleaning', 'grooming', 'playing']
  : ['feeding', 'cage-cleaning', 'exercise', 'socializing'];

const pageTitle = `${pet.name} - ${pet.breed} Profile`;
---

<Layout title={pageTitle}>
  <main class="min-h-screen bg-gradient-to-br from-purple-50 to-pink-100 dark:from-purple-900/20 dark:to-pink-900/20">
    <div class="max-w-4xl mx-auto px-4 py-16">
      <!-- Header -->
      <div class="text-center mb-12">
        <div class="text-8xl mb-4">{pet.image}</div>
        <h1 class="text-4xl font-bold mb-2">Meet {pet.name}</h1>
        <p class="text-xl text-gray-600 dark:text-gray-300">{pet.breed} • {pet.age} years old</p>
        <div class="mt-4 text-sm text-gray-500 dark:text-gray-400">
          Route: <span class="font-mono bg-gray-100 dark:bg-gray-800 px-2 py-1 rounded">/pets/{species}/{name}</span>
        </div>
      </div>

      <!-- Pet Stats -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12">
        <div class="bg-white dark:bg-gray-800 rounded-lg p-6 text-center">
          <div class="text-3xl font-bold text-purple-600 mb-2">{pet.age}</div>
          <div class="text-gray-600 dark:text-gray-400">Years Old</div>
        </div>
        <div class="bg-white dark:bg-gray-800 rounded-lg p-6 text-center">
          <div class="text-3xl font-bold text-purple-600 mb-2">{pet.health}</div>
          <div class="text-gray-600 dark:text-gray-400">Health Status</div>
        </div>
        <div class="bg-white dark:bg-gray-800 rounded-lg p-6 text-center">
          <div class="text-3xl font-bold text-purple-600 mb-2">{pet.personality.length}</div>
          <div class="text-gray-600 dark:text-gray-400">Personality Traits</div>
        </div>
      </div>

      <!-- Personality Traits -->
      <div class="bg-white dark:bg-gray-800 rounded-xl p-8 mb-8">
        <h2 class="text-2xl font-bold mb-6">Personality</h2>
        <div class="flex flex-wrap gap-3">
          {pet.personality.map((trait) => (
            <span class="px-4 py-2 bg-purple-100 dark:bg-purple-900/20 text-purple-700 dark:text-purple-300 rounded-full">
              {trait}
            </span>
          ))}
        </div>
      </div>

      <!-- Favorite Activities -->
      <div class="bg-white dark:bg-gray-800 rounded-xl p-8 mb-8">
        <h2 class="text-2xl font-bold mb-6">Favorite Activities</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          {pet.favoriteActivities.map((activity) => (
            <div class="flex items-center space-x-3 p-3 bg-gray-50 dark:bg-gray-700 rounded-lg">
              <svg class="w-5 h-5 text-purple-500" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
              </svg>
              <span>{activity}</span>
            </div>
          ))}
        </div>
      </div>

      <!-- Care Activities (Nested Route Demo) -->
      <div class="bg-white dark:bg-gray-800 rounded-xl p-8 mb-8">
        <h2 class="text-2xl font-bold mb-6">Care Activities</h2>
        <p class="text-gray-600 dark:text-gray-300 mb-6">
          These links demonstrate nested dynamic routes with rest parameters:
        </p>
        <div class="grid grid-cols-2 md:grid-cols-3 gap-3">
          {careActivities.map((activity) => (
            <a 
              href={`/apps/router/pets/${species}/${name}/care/${activity}`}
              class="block p-3 bg-purple-50 dark:bg-purple-900/20 text-purple-700 dark:text-purple-300 rounded-lg hover:bg-purple-100 dark:hover:bg-purple-900/40 transition-colors text-center"
            >
              {activity.charAt(0).toUpperCase() + activity.slice(1)}
            </a>
          ))}
        </div>
      </div>

      <!-- Route Information -->
      <div class="bg-gradient-to-r from-purple-50 to-pink-50 dark:from-purple-900/20 dark:to-pink-900/20 rounded-xl p-8 mb-8">
        <h2 class="text-2xl font-bold mb-6">Dynamic Route Details</h2>
        <div class="space-y-4 text-sm">
          <div>
            <span class="font-semibold">File path:</span>
            <code class="ml-2 bg-white dark:bg-gray-800 px-2 py-1 rounded font-mono">
              /pages/apps/router/pets/[species]/[name].astro
            </code>
          </div>
          <div>
            <span class="font-semibold">URL pattern:</span>
            <code class="ml-2 bg-white dark:bg-gray-800 px-2 py-1 rounded font-mono">
              /apps/router/pets/[species]/[name]
            </code>
          </div>
          <div>
            <span class="font-semibold">Extracted params:</span>
            <code class="ml-2 bg-white dark:bg-gray-800 px-2 py-1 rounded font-mono">
              species="{species}", name="{name}"
            </code>
          </div>
          <div>
            <span class="font-semibold">Generated for:</span>
            <span class="ml-2 text-purple-600 dark:text-purple-400 font-semibold">
              Every possible species/name combination dynamically
            </span>
          </div>
        </div>
      </div>

      <!-- Implementation Code -->
      <div class="bg-gray-900 rounded-xl p-6 mb-8">
        <h3 class="text-lg font-semibold text-white mb-4">Route Implementation</h3>
        <pre class="text-sm text-gray-300 overflow-x-auto"><code>{`---
// File: /pages/pets/[species]/[name].astro
export const prerender = false; // SSR for dynamic data

const { species, name } = Astro.params;

// Look up pet data dynamically
const petKey = \`\${species}-\${name?.toLowerCase()}\`;
const pet = petDatabase[petKey];

if (!pet) {
  return Astro.redirect('/404');
}
---

<h1>Meet {pet.name}</h1>
<p>{pet.breed} • {pet.age} years old</p>`}</code></pre>
      </div>

      <!-- More Examples -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
        <div class="bg-white dark:bg-gray-800 rounded-lg p-6">
          <h3 class="font-semibold mb-4">Try Other Pets</h3>
          <div class="space-y-2">
            <a href="/apps/router/pets/cat/whiskers" class="block text-purple-600 dark:text-purple-400 hover:underline">
              🐱 Whiskers the Persian Cat
            </a>
            <a href="/apps/router/pets/bird/tweety" class="block text-purple-600 dark:text-purple-400 hover:underline">
              🐦 Tweety the Canary
            </a>
            <a href="/apps/router/pets/hamster/nibbles" class="block text-gray-500 hover:underline">
              🐹 Nibbles (Not Found Demo)
            </a>
          </div>
        </div>

        <div class="bg-white dark:bg-gray-800 rounded-lg p-6">
          <h3 class="font-semibold mb-4">Visit Info</h3>
          <p class="text-sm text-gray-600 dark:text-gray-400 mb-2">
            Last vet visit: <span class="font-semibold">{pet.lastVisit}</span>
          </p>
          <p class="text-sm text-gray-600 dark:text-gray-400">
            Health status: <span class="font-semibold text-green-600">{pet.health}</span>
          </p>
        </div>
      </div>

      <!-- Navigation -->
      <div class="text-center">
        <a 
          href="/apps/router" 
          class="inline-flex items-center px-6 py-3 bg-purple-600 text-white rounded-lg hover:bg-purple-700 transition-colors"
        >
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
          </svg>
          Back to Router Examples
        </a>
      </div>
    </div>
  </main>
</Layout>