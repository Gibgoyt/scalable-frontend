---
import Layout from 'src/layouts/Layout.astro';

// Mock data for examples
const routingExamples = [
	{
		category: "Static vs Dynamic Routes",
		description: "Understanding when to use SSG vs SSR",
		examples: [
			{ url: "/apps/router/static-example", label: "Static Route (SSG)", type: "SSG" },
			{ url: "/apps/router/dynamic-example", label: "Dynamic Route (SSR)", type: "SSR" },
		]
	},
	{
		category: "Multi-Level Dynamic Routing",
		description: "Complex nested route structures",
		examples: [
			{ url: "/apps/router/pets/dog/buddy", label: "Pet Profile: Dog named Buddy", type: "Dynamic" },
			{ url: "/apps/router/pets/cat/whiskers/care/feeding", label: "Pet Care Activity", type: "Rest Params" },
			{ url: "/apps/router/courses/javascript/basics/lessons/variables/scope", label: "Deep Learning Path", type: "Rest Params" },
		]
	},
	{
		category: "Pagination Examples",
		description: "Paginated content with dynamic routes",
		examples: [
			{ url: "/apps/router/events/san-francisco/1", label: "Events in San Francisco (Page 1)", type: "Paginated" },
			{ url: "/apps/router/marketplace/electronics/phones/2", label: "Electronics > Phones (Page 2)", type: "Paginated" },
		]
	},
	{
		category: "Route Priority Demos",
		description: "Understanding how Astro resolves conflicting routes",
		examples: [
			{ url: "/apps/router/blog/create", label: "Blog Creation (Static Priority)", type: "Static Priority" },
			{ url: "/apps/router/blog/my-first-post", label: "Blog Post (Dynamic Fallback)", type: "Dynamic Priority" },
		]
	},
	{
		category: "Advanced Patterns",
		description: "Redirects, rewrites, and middleware examples",
		examples: [
			{ url: "/apps/router/redirect-demo", label: "Redirect Example", type: "Redirect" },
			{ url: "/apps/router/rewrite-demo", label: "Rewrite Example", type: "Rewrite" },
			{ url: "/apps/router/api/weather/london", label: "API Endpoint", type: "API" },
		]
	}
];

const codeExamples = [
	{
		title: "SSG Route (Prerendered)",
		code: `---
// src/pages/static-example.astro
export const prerender = true; // Force SSG

const staticData = {
  title: "Fast Loading Page",
  loadTime: "< 50ms",
  seo: "Excellent"
};
---
<h1>{staticData.title}</h1>
<p>This page is pre-rendered at build time</p>`
	},
	{
		title: "SSR Route (Dynamic)",
		code: `---
// src/pages/dynamic-example.astro
// No prerender = SSR by default

const userAgent = Astro.request.headers.get('user-agent');
const currentTime = new Date().toLocaleString();
---
<h1>Dynamic Content</h1>
<p>Generated at: {currentTime}</p>
<p>Your browser: {userAgent}</p>`
	},
	{
		title: "Multi-Level Dynamic Route",
		code: `---
// src/pages/pets/[species]/[name]/care/[...activity].astro
export const prerender = false;

const { species, name, activity } = Astro.params;
const activityPath = activity || '';

// Mock pet data
const petData = {
  species,
  name,
  currentActivity: activityPath.split('/').pop() || 'resting'
};
---
<h1>{petData.name} the {petData.species}</h1>
<p>Activity: {petData.currentActivity}</p>`
	},
	{
		title: "Paginated Route",
		code: `---
// src/pages/events/[city]/[page].astro
export function getStaticPaths() {
  const cities = ['san-francisco', 'new-york', 'london'];
  const pages = [1, 2, 3];
  
  return cities.flatMap(city => 
    pages.map(page => ({
      params: { city, page: page.toString() }
    }))
  );
}

const { city, page } = Astro.params;
const events = getEventsForCity(city, parseInt(page));
---`
	}
];
---

<Layout title="Astro Routing Examples - ASSQ-CloudFlare Stack">
	<main class="min-h-screen bg-gradient-to-br from-blue-50 via-white to-purple-50 dark:from-gray-900 dark:via-gray-800 dark:to-purple-900">



		<!-- Hero Section -->
		<section class="py-16 lg:py-24">
			<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
				<div class="text-center mb-16">
					<h1 class="text-4xl lg:text-6xl font-bold mb-6 bg-gradient-to-r from-blue-600 to-purple-600 bg-clip-text text-transparent">
						Astro Routing Mastery
					</h1>
					<p class="text-xl text-gray-600 dark:text-gray-300 max-w-3xl mx-auto mb-8">
						Explore Astro's powerful file-based routing system with static routes, dynamic parameters, pagination, redirects, and advanced patterns.
					</p>
					<div class="flex flex-wrap justify-center gap-4">
						<span class="px-4 py-2 bg-green-100 dark:bg-green-900/20 text-green-700 dark:text-green-300 rounded-full text-sm font-medium">
							✅ SSG + SSR Hybrid
						</span>
						<span class="px-4 py-2 bg-blue-100 dark:bg-blue-900/20 text-blue-700 dark:text-blue-300 rounded-full text-sm font-medium">
							🛣️ Dynamic Routes
						</span>
						<span class="px-4 py-2 bg-purple-100 dark:bg-purple-900/20 text-purple-700 dark:text-purple-300 rounded-full text-sm font-medium">
							📄 Pagination
						</span>
						<span class="px-4 py-2 bg-orange-100 dark:bg-orange-900/20 text-orange-700 dark:text-orange-300 rounded-full text-sm font-medium">
							🔄 Redirects & Rewrites
						</span>
					</div>
					<div class="flex justify-center items-center my-8 mx-4">
						<a
							href="https://docs.astro.build/en/guides/routing/"
							target="_blank"
							rel="noopener noreferrer"
							class="inline-flex items-center justify-center px-6 py-3 text-base font-medium text-white bg-gradient-to-r from-purple-600 to-blue-600 border border-transparent rounded-lg shadow-lg hover:from-purple-700 hover:to-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-purple-500 transition-all duration-200 transform hover:scale-105"
						>
							<svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 24 24">
								<path d="M12 2L2 7L12 12L22 7L12 2Z"/>
								<path d="M2 17L12 22L22 17"/>
								<path d="M2 12L12 17L22 12"/>
							</svg>
							Astro Docs
						</a>
					</div>
				</div>

				<!-- SSG vs SSR Decision Framework -->
				<div class="mb-16">
					<h2 class="text-3xl font-bold text-center mb-12">SSG vs SSR Decision Framework</h2>
					<div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
						<div class="bg-green-50 dark:bg-green-900/10 rounded-xl p-8 border border-green-200 dark:border-green-800">
							<div class="flex items-center mb-6">
								<div class="w-12 h-12 bg-green-500 rounded-lg flex items-center justify-center mr-4">
									<svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
									</svg>
								</div>
								<h3 class="text-2xl font-bold text-green-800 dark:text-green-200">Use SSG When</h3>
							</div>
							<ul class="space-y-3 text-green-700 dark:text-green-300">
								<li class="flex items-start space-x-3">
									<svg class="w-5 h-5 mt-0.5 text-green-500 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
										<path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
									</svg>
									<span>Content rarely changes (marketing pages, docs)</span>
								</li>
								<li class="flex items-start space-x-3">
									<svg class="w-5 h-5 mt-0.5 text-green-500 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
										<path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
									</svg>
									<span>SEO-critical pages needing fast loading</span>
								</li>
								<li class="flex items-start space-x-3">
									<svg class="w-5 h-5 mt-0.5 text-green-500 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
										<path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
									</svg>
									<span>Known routes at build time</span>
								</li>
								<li class="flex items-start space-x-3">
									<svg class="w-5 h-5 mt-0.5 text-green-500 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
										<path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
									</svg>
									<span>Public content without user-specific data</span>
								</li>
							</ul>
						</div>

						<div class="bg-blue-50 dark:bg-blue-900/10 rounded-xl p-8 border border-blue-200 dark:border-blue-800">
							<div class="flex items-center mb-6">
								<div class="w-12 h-12 bg-blue-500 rounded-lg flex items-center justify-center mr-4">
									<svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2"></path>
									</svg>
								</div>
								<h3 class="text-2xl font-bold text-blue-800 dark:text-blue-200">Use SSR When</h3>
							</div>
							<ul class="space-y-3 text-blue-700 dark:text-blue-300">
								<li class="flex items-start space-x-3">
									<svg class="w-5 h-5 mt-0.5 text-blue-500 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
										<path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
									</svg>
									<span>User-specific content (dashboards, profiles)</span>
								</li>
								<li class="flex items-start space-x-3">
									<svg class="w-5 h-5 mt-0.5 text-blue-500 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
										<path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
									</svg>
									<span>Real-time data that changes frequently</span>
								</li>
								<li class="flex items-start space-x-3">
									<svg class="w-5 h-5 mt-0.5 text-blue-500 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
										<path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
									</svg>
									<span>Pages depending on request headers/cookies</span>
								</li>
								<li class="flex items-start space-x-3">
									<svg class="w-5 h-5 mt-0.5 text-blue-500 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
										<path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
									</svg>
									<span>Dynamic content from user input/database</span>
								</li>
							</ul>
						</div>
					</div>
				</div>

				<!-- Interactive Examples -->
				<div class="mb-16">
					<h2 class="text-3xl font-bold text-center mb-12">Interactive Routing Examples</h2>
					<div class="grid grid-cols-1 lg:grid-cols-2 xl:grid-cols-3 gap-8">
						{routingExamples.map((category) => (
							<div class="bg-white dark:bg-gray-800 rounded-xl shadow-lg p-8">
								<h3 class="text-xl font-semibold mb-3">{category.category}</h3>
								<p class="text-gray-600 dark:text-gray-300 mb-6 text-sm">{category.description}</p>
								<div class="space-y-3">
									{category.examples.map((example) => (
										<a 
											href={example.url} 
											class="block p-3 rounded-lg border border-gray-200 dark:border-gray-700 hover:border-blue-300 dark:hover:border-blue-600 hover:bg-blue-50 dark:hover:bg-blue-900/20 transition-colors group"
										>
											<div class="flex items-center justify-between">
												<span class="text-sm font-medium group-hover:text-blue-600 dark:group-hover:text-blue-400">
													{example.label}
												</span>
												<span class={`text-xs px-2 py-1 rounded ${
													example.type === 'SSG' ? 'bg-green-100 dark:bg-green-900/20 text-green-700 dark:text-green-300' :
													example.type === 'SSR' ? 'bg-blue-100 dark:bg-blue-900/20 text-blue-700 dark:text-blue-300' :
													example.type === 'API' ? 'bg-purple-100 dark:bg-purple-900/20 text-purple-700 dark:text-purple-300' :
													'bg-orange-100 dark:bg-orange-900/20 text-orange-700 dark:text-orange-300'
												}`}>
													{example.type}
												</span>
											</div>
										</a>
									))}
								</div>
							</div>
						))}
					</div>
				</div>

				<!-- Code Examples -->
				<div class="mb-16">
					<h2 class="text-3xl font-bold text-center mb-12">Code Examples</h2>
					<div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
						{codeExamples.map((example) => (
							<div class="bg-gray-900 rounded-xl p-6">
								<h3 class="text-lg font-semibold text-white mb-4">{example.title}</h3>
								<pre class="text-sm text-gray-300 overflow-x-auto"><code>{example.code}</code></pre>
							</div>
						))}
					</div>
				</div>

				<!-- Route Priority Explanation -->
				<div class="mb-16">
					<div class="bg-gradient-to-r from-purple-50 to-pink-50 dark:from-purple-900/20 dark:to-pink-900/20 rounded-xl p-8">
						<h2 class="text-3xl font-bold text-center mb-8">Route Priority Order</h2>
						<div class="max-w-4xl mx-auto">
							<p class="text-lg text-gray-700 dark:text-gray-300 mb-8 text-center">
								When multiple routes could match the same URL, Astro uses this priority order:
							</p>
							<div class="space-y-4">
								{[
									{ priority: 1, rule: "Static routes without path parameters", example: "/blog/create.astro" },
									{ priority: 2, rule: "Dynamic routes with named parameters", example: "/blog/[slug].astro" },
									{ priority: 3, rule: "Dynamic routes with rest parameters", example: "/blog/[...path].astro" },
									{ priority: 4, rule: "File-based routes vs redirects", example: "Physical files take precedence" }
								].map((item) => (
									<div class="flex items-center space-x-4 p-4 bg-white dark:bg-gray-800 rounded-lg">
										<div class="flex-shrink-0 w-8 h-8 bg-purple-500 text-white rounded-full flex items-center justify-center font-bold">
											{item.priority}
										</div>
										<div class="flex-1">
											<p class="font-semibold">{item.rule}</p>
											<p class="text-sm text-gray-600 dark:text-gray-400">{item.example}</p>
										</div>
									</div>
								))}
							</div>
						</div>
					</div>
				</div>

				<!-- Performance Tips -->
				<div class="bg-gradient-to-br from-blue-50 to-indigo-50 dark:from-blue-900/20 dark:to-indigo-900/20 rounded-xl p-8">
					<h2 class="text-3xl font-bold text-center mb-8">Performance & Best Practices</h2>
					<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
						<div class="text-center">
							<div class="w-16 h-16 bg-green-500 rounded-full flex items-center justify-center mx-auto mb-4">
								<svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
								</svg>
							</div>
							<h3 class="font-semibold mb-2">SSG Performance</h3>
							<p class="text-sm text-gray-600 dark:text-gray-400">Pre-rendered pages load in &lt;50ms with perfect SEO</p>
						</div>
						<div class="text-center">
							<div class="w-16 h-16 bg-blue-500 rounded-full flex items-center justify-center mx-auto mb-4">
								<svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7v10c0 2.21 3.79 4 8 4s8-1.79 8-4V7c0-2.21-3.79-4-8-4S4 4.79 4 7z"></path>
								</svg>
							</div>
							<h3 class="font-semibold mb-2">Smart Caching</h3>
							<p class="text-sm text-gray-600 dark:text-gray-400">Cache static assets, personalize dynamic content</p>
						</div>
						<div class="text-center">
							<div class="w-16 h-16 bg-purple-500 rounded-full flex items-center justify-center mx-auto mb-4">
								<svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
								</svg>
							</div>
							<h3 class="font-semibold mb-2">Progressive Enhancement</h3>
							<p class="text-sm text-gray-600 dark:text-gray-400">Start static, add interactivity where needed</p>
						</div>
					</div>
				</div>
			</div>
		</section>
	</main>
</Layout>