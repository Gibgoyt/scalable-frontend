---
import Layout from 'src/layouts/Layout.astro';

// Demonstrate rewrite functionality
const url = new URL(Astro.request.url);
const rewriteTo = url.searchParams.get('rewrite');

// Simulate different rewrite scenarios
if (rewriteTo === 'static') {
  // This would normally rewrite to show static content
  // but we'll demonstrate the concept instead
}

export const prerender = false; // SSR for rewrite logic
---

<Layout title="Rewrite Demo - Astro Routing">
  <main class="min-h-screen bg-gradient-to-br from-teal-50 to-cyan-100 dark:from-teal-900/20 dark:to-cyan-900/20">
    <div class="max-w-4xl mx-auto px-4 py-16">
      <!-- Header -->
      <div class="text-center mb-12">
        <div class="inline-flex items-center justify-center w-16 h-16 bg-teal-500 rounded-full mb-6">
          <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"></path>
          </svg>
        </div>
        <h1 class="text-4xl font-bold mb-4 text-gray-900 dark:text-white">Rewrite Demonstration</h1>
        <p class="text-xl text-gray-600 dark:text-gray-300">Learn how Astro handles URL rewrites</p>
        {rewriteTo && (
          <div class="mt-4 p-3 bg-teal-100 dark:bg-teal-900/20 border border-teal-200 dark:border-teal-800 rounded-lg">
            <p class="text-teal-800 dark:text-teal-200 font-semibold">
              🔄 This page is demonstrating a rewrite to: {rewriteTo}
            </p>
          </div>
        )}
      </div>

      <!-- Rewrite vs Redirect Comparison -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-12">
        <div class="bg-white dark:bg-gray-800 rounded-xl p-8 border-l-4 border-teal-500">
          <h2 class="text-2xl font-bold mb-4 text-gray-900 dark:text-white flex items-center">
            <svg class="w-6 h-6 mr-2 text-teal-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"></path>
            </svg>
            Rewrite
          </h2>
          <ul class="space-y-3 text-sm text-gray-600 dark:text-gray-300">
            <li class="flex items-start">
              <svg class="w-4 h-4 mt-1 mr-2 text-green-500 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
              </svg>
              URL stays the same
            </li>
            <li class="flex items-start">
              <svg class="w-4 h-4 mt-1 mr-2 text-green-500 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
              </svg>
              Content comes from different source
            </li>
            <li class="flex items-start">
              <svg class="w-4 h-4 mt-1 mr-2 text-green-500 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
              </svg>
              No additional HTTP request
            </li>
            <li class="flex items-start">
              <svg class="w-4 h-4 mt-1 mr-2 text-green-500 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
              </svg>
              Better for SEO and UX
            </li>
          </ul>
        </div>

        <div class="bg-white dark:bg-gray-800 rounded-xl p-8 border-l-4 border-orange-500">
          <h2 class="text-2xl font-bold mb-4 text-gray-900 dark:text-white flex items-center">
            <svg class="w-6 h-6 mr-2 text-orange-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5M7 12h11"></path>
            </svg>
            Redirect
          </h2>
          <ul class="space-y-3 text-sm text-gray-600 dark:text-gray-300">
            <li class="flex items-start">
              <svg class="w-4 h-4 mt-1 mr-2 text-orange-500 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd"></path>
              </svg>
              URL changes in browser
            </li>
            <li class="flex items-start">
              <svg class="w-4 h-4 mt-1 mr-2 text-orange-500 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd"></path>
              </svg>
              Additional HTTP request
            </li>
            <li class="flex items-start">
              <svg class="w-4 h-4 mt-1 mr-2 text-orange-500 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd"></path>
              </svg>
              User sees URL change
            </li>
            <li class="flex items-start">
              <svg class="w-4 h-4 mt-1 mr-2 text-green-500 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
              </svg>
              Good for permanent moves
            </li>
          </ul>
        </div>
      </div>

      <!-- How Rewrites Work -->
      <div class="bg-teal-50 dark:bg-teal-900/20 rounded-xl p-8 mb-8 border border-teal-200 dark:border-teal-800">
        <h2 class="text-2xl font-bold mb-6 text-gray-900 dark:text-white">How Astro Rewrites Work</h2>
        
        <div class="space-y-6">
          <!-- Page Rewrites -->
          <div class="bg-white dark:bg-gray-800 rounded-lg p-6">
            <h3 class="text-lg font-semibold mb-4 text-gray-900 dark:text-white flex items-center">
              <svg class="w-5 h-5 mr-2 text-teal-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
              </svg>
              Page Rewrites
            </h3>
            <p class="text-gray-600 dark:text-gray-300 mb-4">
              Use <code class="bg-gray-100 dark:bg-gray-700 px-2 py-1 rounded">Astro.rewrite()</code> to serve different content while keeping the original URL.
            </p>
            <div class="bg-gray-900 dark:bg-gray-900 rounded-lg p-4">
              <pre class="text-sm text-gray-300"><code>{`---
// Show localized content based on region
const region = getRegionFromIP(Astro.clientAddress);

if (region === 'EU') {
  return Astro.rewrite('/eu/privacy-policy');
}

if (region === 'CA') {
  return Astro.rewrite('/ca/privacy-policy');
}
---

<h1>Default Privacy Policy</h1>`}</code></pre>
            </div>
          </div>

          <!-- Middleware Rewrites -->
          <div class="bg-white dark:bg-gray-800 rounded-lg p-6">
            <h3 class="text-lg font-semibold mb-4 text-gray-900 dark:text-white flex items-center">
              <svg class="w-5 h-5 mr-2 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path>
              </svg>
              Middleware Rewrites
            </h3>
            <p class="text-gray-600 dark:text-gray-300 mb-4">
              Rewrite requests in middleware for powerful URL manipulation.
            </p>
            <div class="bg-gray-900 dark:bg-gray-900 rounded-lg p-4">
              <pre class="text-sm text-gray-300"><code>{`// src/middleware.ts
export const onRequest = async (context, next) => {
  const url = new URL(context.request.url);
  
  // A/B testing
  if (url.pathname === '/landing' && Math.random() < 0.5) {
    return context.rewrite('/landing-variant-b');
  }
  
  // Handle 404s gracefully
  const response = await next();
  if (response.status === 404) {
    return context.rewrite('/custom-404');
  }
  
  return response;
};`}</code></pre>
            </div>
          </div>
        </div>
      </div>

      <!-- Rewrite Use Cases -->
      <div class="bg-white dark:bg-gray-800 rounded-xl p-8 mb-8">
        <h3 class="text-xl font-semibold mb-6 text-gray-900 dark:text-white">Common Rewrite Use Cases</h3>
        
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          <div class="bg-gradient-to-br from-blue-50 to-indigo-100 dark:from-blue-900/30 dark:to-indigo-900/30 p-6 rounded-lg">
            <h4 class="font-semibold text-gray-900 dark:text-white mb-3 flex items-center">
              <span class="text-2xl mr-2">🌍</span>
              Internationalization
            </h4>
            <p class="text-sm text-gray-600 dark:text-gray-400">
              Serve localized content based on user location or preferences without changing the URL.
            </p>
          </div>
          
          <div class="bg-gradient-to-br from-green-50 to-emerald-100 dark:from-green-900/30 dark:to-emerald-900/30 p-6 rounded-lg">
            <h4 class="font-semibold text-gray-900 dark:text-white mb-3 flex items-center">
              <span class="text-2xl mr-2">🧪</span>
              A/B Testing
            </h4>
            <p class="text-sm text-gray-600 dark:text-gray-400">
              Show different page variants to users while maintaining consistent URLs for analytics.
            </p>
          </div>
          
          <div class="bg-gradient-to-br from-purple-50 to-pink-100 dark:from-purple-900/30 dark:to-pink-900/30 p-6 rounded-lg">
            <h4 class="font-semibold text-gray-900 dark:text-white mb-3 flex items-center">
              <span class="text-2xl mr-2">🛡️</span>
              Graceful Fallbacks
            </h4>
            <p class="text-sm text-gray-600 dark:text-gray-400">
              Handle errors elegantly by rewriting to custom error pages or fallback content.
            </p>
          </div>
          
          <div class="bg-gradient-to-br from-orange-50 to-red-100 dark:from-orange-900/30 dark:to-red-900/30 p-6 rounded-lg">
            <h4 class="font-semibold text-gray-900 dark:text-white mb-3 flex items-center">
              <span class="text-2xl mr-2">📱</span>
              Device-Specific
            </h4>
            <p class="text-sm text-gray-600 dark:text-gray-400">
              Serve mobile-optimized pages for mobile users while keeping desktop URLs.
            </p>
          </div>
          
          <div class="bg-gradient-to-br from-cyan-50 to-blue-100 dark:from-cyan-900/30 dark:to-blue-900/30 p-6 rounded-lg">
            <h4 class="font-semibold text-gray-900 dark:text-white mb-3 flex items-center">
              <span class="text-2xl mr-2">⚡</span>
              Feature Flags
            </h4>
            <p class="text-sm text-gray-600 dark:text-gray-400">
              Toggle features on/off by rewriting to different implementations based on flags.
            </p>
          </div>
          
          <div class="bg-gradient-to-br from-yellow-50 to-orange-100 dark:from-yellow-900/30 dark:to-orange-900/30 p-6 rounded-lg">
            <h4 class="font-semibold text-gray-900 dark:text-white mb-3 flex items-center">
              <span class="text-2xl mr-2">🔍</span>
              SEO Optimization
            </h4>
            <p class="text-sm text-gray-600 dark:text-gray-400">
              Serve SEO-optimized content for bots while keeping rich UX for users.
            </p>
          </div>
        </div>
      </div>

      <!-- Interactive Demo -->
      <div class="bg-white dark:bg-gray-800 rounded-xl p-8 mb-8">
        <h3 class="text-xl font-semibold mb-6 text-gray-900 dark:text-white">Try Rewrite Examples</h3>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <a 
            href="/apps/router/rewrite-demo?rewrite=static"
            class="block p-4 bg-teal-100 dark:bg-teal-900/20 text-teal-700 dark:text-teal-300 rounded-lg hover:bg-teal-200 dark:hover:bg-teal-900/40 transition-colors"
          >
            <div class="font-semibold mb-2">🔄 Rewrite to Static Content</div>
            <div class="text-sm">Same URL, different content source</div>
          </a>
          
          <a 
            href="/apps/router/rewrite-demo?rewrite=dynamic"
            class="block p-4 bg-blue-100 dark:bg-blue-900/20 text-blue-700 dark:text-blue-300 rounded-lg hover:bg-blue-200 dark:hover:bg-blue-900/40 transition-colors"
          >
            <div class="font-semibold mb-2">⚡ Rewrite to Dynamic Content</div>
            <div class="text-sm">URL stays, content varies by user</div>
          </a>
          
          <a 
            href="/apps/router/rewrite-demo?rewrite=localized"
            class="block p-4 bg-green-100 dark:bg-green-900/20 text-green-700 dark:text-green-300 rounded-lg hover:bg-green-200 dark:hover:bg-green-900/40 transition-colors"
          >
            <div class="font-semibold mb-2">🌍 Rewrite to Localized Content</div>
            <div class="text-sm">Region-specific content delivery</div>
          </a>
          
          <a 
            href="/apps/router/rewrite-demo?rewrite=fallback"
            class="block p-4 bg-purple-100 dark:bg-purple-900/20 text-purple-700 dark:text-purple-300 rounded-lg hover:bg-purple-200 dark:hover:bg-purple-900/40 transition-colors"
          >
            <div class="font-semibold mb-2">🛡️ Rewrite to Fallback Content</div>
            <div class="text-sm">Graceful error handling</div>
          </div>
        </div>
      </div>

      <!-- Current Request Info -->
      <div class="bg-gradient-to-r from-teal-100 to-cyan-100 dark:from-teal-900/30 dark:to-cyan-900/30 rounded-xl p-8 mb-8">
        <h3 class="text-xl font-semibold mb-6 text-gray-900 dark:text-white">Current Request Information</h3>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 text-sm">
          <div>
            <span class="font-semibold text-gray-700 dark:text-gray-300">Original URL:</span>
            <code class="ml-2 bg-white dark:bg-gray-800 px-2 py-1 rounded text-xs break-all">
              {Astro.url.href}
            </code>
          </div>
          <div>
            <span class="font-semibold text-gray-700 dark:text-gray-300">Query Params:</span>
            <code class="ml-2 bg-white dark:bg-gray-800 px-2 py-1 rounded text-xs">
              {Astro.url.search || 'none'}
            </code>
          </div>
        </div>
        
        {rewriteTo && (
          <div class="mt-4 p-4 bg-teal-200 dark:bg-teal-900/40 border border-teal-300 dark:border-teal-700 rounded-lg">
            <p class="text-teal-800 dark:text-teal-200 font-semibold">
              🔄 Demonstrating rewrite scenario: {rewriteTo}
            </p>
            <p class="text-teal-700 dark:text-teal-300 text-sm mt-1">
              In a real implementation, this content would come from a different source while the URL remains unchanged.
            </p>
          </div>
        )}
      </div>

      <!-- Key Differences -->
      <div class="bg-gray-50 dark:bg-gray-700 rounded-xl p-8 mb-8">
        <h3 class="text-xl font-semibold mb-6 text-gray-900 dark:text-white">Key Differences: Rewrite vs Redirect</h3>
        
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead>
              <tr class="border-b border-gray-200 dark:border-gray-600">
                <th class="text-left py-3 px-4 font-semibold text-gray-900 dark:text-white">Aspect</th>
                <th class="text-left py-3 px-4 font-semibold text-gray-900 dark:text-white">Rewrite</th>
                <th class="text-left py-3 px-4 font-semibold text-gray-900 dark:text-white">Redirect</th>
              </tr>
            </thead>
            <tbody class="text-gray-600 dark:text-gray-400">
              <tr class="border-b border-gray-100 dark:border-gray-600">
                <td class="py-3 px-4 font-medium">URL in Browser</td>
                <td class="py-3 px-4">✅ Stays the same</td>
                <td class="py-3 px-4">❌ Changes</td>
              </tr>
              <tr class="border-b border-gray-100 dark:border-gray-600">
                <td class="py-3 px-4 font-medium">HTTP Requests</td>
                <td class="py-3 px-4">✅ Single request</td>
                <td class="py-3 px-4">❌ Multiple requests</td>
              </tr>
              <tr class="border-b border-gray-100 dark:border-gray-600">
                <td class="py-3 px-4 font-medium">SEO Impact</td>
                <td class="py-3 px-4">✅ Preserves URL authority</td>
                <td class="py-3 px-4">⚠️ May transfer authority</td>
              </tr>
              <tr class="border-b border-gray-100 dark:border-gray-600">
                <td class="py-3 px-4 font-medium">User Experience</td>
                <td class="py-3 px-4">✅ Seamless</td>
                <td class="py-3 px-4">⚠️ Visible change</td>
              </tr>
              <tr>
                <td class="py-3 px-4 font-medium">Use Case</td>
                <td class="py-3 px-4">Content variations</td>
                <td class="py-3 px-4">Permanent moves</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <!-- Navigation -->
      <div class="text-center">
        <a 
          href="/apps/router" 
          class="inline-flex items-center px-6 py-3 bg-teal-600 text-white rounded-lg hover:bg-teal-700 transition-colors"
        >
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
          </svg>
          Back to Router Examples
        </a>
      </div>
    </div>
  </main>
</Layout>