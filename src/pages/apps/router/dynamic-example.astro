---
import Layout from 'src/layouts/Layout.astro';

// SSR by default - this page is rendered on each request
// export const prerender = false; // This is the default

// Get request information
const userAgent = Astro.request.headers.get('user-agent') || 'Unknown';
const currentTime = new Date().toLocaleString();
const requestUrl = Astro.url.href;
const requestMethod = Astro.request.method;
const clientIP = Astro.clientAddress;

// Simulate some dynamic data fetching
const dynamicData = {
  title: "Dynamic Route Example (SSR)",
  description: "This page is rendered fresh on every request",
  requestTime: currentTime,
  sessionId: Math.random().toString(36).substring(2, 15),
  features: [
    "Server-side rendering",
    "Request-specific data",
    "Real-time information",
    "User personalization",
    "Dynamic content generation"
  ]
};

// Simulate fetching user-specific or real-time data
const realtimeData = {
  serverLoad: Math.floor(Math.random() * 100),
  activeUsers: Math.floor(Math.random() * 1000) + 100,
  requestCount: Math.floor(Math.random() * 10000) + 1000,
  temperature: (Math.random() * 30 + 10).toFixed(1) + '°C'
};
---

<Layout title={dynamicData.title}>
  <main class="min-h-screen bg-gradient-to-br from-blue-50 to-indigo-100 dark:from-blue-900/20 dark:to-indigo-900/20">
    <div class="max-w-4xl mx-auto px-4 py-16">
      <!-- Header -->
      <div class="text-center mb-12">
        <div class="inline-flex items-center justify-center w-16 h-16 bg-blue-500 rounded-full mb-6">
          <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2"></path>
          </svg>
        </div>
        <h1 class="text-4xl font-bold mb-4">{dynamicData.title}</h1>
        <p class="text-xl text-gray-600 dark:text-gray-300">{dynamicData.description}</p>
      </div>

      <!-- Real-time Metrics -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-12">
        <div class="bg-white dark:bg-gray-800 rounded-lg p-4 text-center">
          <div class="text-2xl font-bold text-blue-600 mb-1">{realtimeData.serverLoad}%</div>
          <div class="text-sm text-gray-600 dark:text-gray-400">Server Load</div>
        </div>
        <div class="bg-white dark:bg-gray-800 rounded-lg p-4 text-center">
          <div class="text-2xl font-bold text-blue-600 mb-1">{realtimeData.activeUsers}</div>
          <div class="text-sm text-gray-600 dark:text-gray-400">Active Users</div>
        </div>
        <div class="bg-white dark:bg-gray-800 rounded-lg p-4 text-center">
          <div class="text-2xl font-bold text-blue-600 mb-1">{realtimeData.requestCount}</div>
          <div class="text-sm text-gray-600 dark:text-gray-400">Requests Today</div>
        </div>
        <div class="bg-white dark:bg-gray-800 rounded-lg p-4 text-center">
          <div class="text-2xl font-bold text-blue-600 mb-1">{realtimeData.temperature}</div>
          <div class="text-sm text-gray-600 dark:text-gray-400">Server Temp</div>
        </div>
      </div>

      <!-- Request Information -->
      <div class="bg-white dark:bg-gray-800 rounded-xl p-8 mb-12">
        <h2 class="text-2xl font-bold mb-6">Request Information</h2>
        <div class="space-y-4">
          <div class="flex flex-col sm:flex-row sm:items-center">
            <span class="font-semibold text-gray-700 dark:text-gray-300 sm:w-32">Generated:</span>
            <span class="text-blue-600 dark:text-blue-400 font-mono">{dynamicData.requestTime}</span>
          </div>
          <div class="flex flex-col sm:flex-row sm:items-center">
            <span class="font-semibold text-gray-700 dark:text-gray-300 sm:w-32">Session ID:</span>
            <span class="text-blue-600 dark:text-blue-400 font-mono">{dynamicData.sessionId}</span>
          </div>
          <div class="flex flex-col sm:flex-row sm:items-center">
            <span class="font-semibold text-gray-700 dark:text-gray-300 sm:w-32">Client IP:</span>
            <span class="text-blue-600 dark:text-blue-400 font-mono">{clientIP}</span>
          </div>
          <div class="flex flex-col sm:flex-row sm:items-start">
            <span class="font-semibold text-gray-700 dark:text-gray-300 sm:w-32">User Agent:</span>
            <span class="text-blue-600 dark:text-blue-400 font-mono text-sm break-all">{userAgent}</span>
          </div>
          <div class="flex flex-col sm:flex-row sm:items-center">
            <span class="font-semibold text-gray-700 dark:text-gray-300 sm:w-32">Method:</span>
            <span class="text-blue-600 dark:text-blue-400 font-mono">{requestMethod}</span>
          </div>
        </div>
      </div>

      <!-- SSR Features -->
      <div class="bg-white dark:bg-gray-800 rounded-xl p-8 mb-12">
        <h2 class="text-2xl font-bold mb-6">SSR Features</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {dynamicData.features.map((feature) => (
            <div class="flex items-center space-x-3">
              <svg class="w-5 h-5 text-blue-500" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
              </svg>
              <span>{feature}</span>
            </div>
          ))}
        </div>
      </div>

      <!-- Code Example -->
      <div class="bg-gray-900 rounded-xl p-6 mb-12">
        <h3 class="text-lg font-semibold text-white mb-4">Implementation</h3>
        <pre class="text-sm text-gray-300 overflow-x-auto"><code>{`---
// SSR by default - no prerender needed
const userAgent = Astro.request.headers.get('user-agent');
const currentTime = new Date().toLocaleString();
const clientIP = Astro.clientAddress;

// Fetch real-time data, check user auth, etc.
const dynamicData = await fetchUserSpecificData();
---

<Layout title="Dynamic SSR Page">
  <h1>Generated at: {currentTime}</h1>
  <p>Your IP: {clientIP}</p>
  <p>Browser: {userAgent}</p>
</Layout>`}</code></pre>
      </div>

      <!-- Refresh Demo -->
      <div class="bg-blue-50 dark:bg-blue-900/20 rounded-lg p-6 border border-blue-200 dark:border-blue-800 mb-12">
        <h3 class="font-semibold text-blue-800 dark:text-blue-200 mb-2">Refresh to See Changes</h3>
        <p class="text-blue-700 dark:text-blue-300 text-sm mb-4">
          Every page refresh generates new content because this page is rendered on the server for each request.
        </p>
        <button 
          onclick="window.location.reload()"
          class="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors"
        >
          Refresh Page
        </button>
      </div>

      <!-- Performance Comparison -->
      <div class="bg-yellow-50 dark:bg-yellow-900/20 rounded-lg p-6 border border-yellow-200 dark:border-yellow-800 mb-12">
        <h3 class="font-semibold text-yellow-800 dark:text-yellow-200 mb-2">Performance Trade-offs</h3>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-sm">
          <div>
            <h4 class="font-semibold text-green-700 dark:text-green-300 mb-2">✅ Benefits:</h4>
            <ul class="space-y-1 text-green-600 dark:text-green-400">
              <li>• Real-time, personalized content</li>
              <li>• Access to request headers & user data</li>
              <li>• Dynamic database queries</li>
              <li>• Server-side authentication</li>
            </ul>
          </div>
          <div>
            <h4 class="font-semibold text-orange-700 dark:text-orange-300 mb-2">⚠️ Considerations:</h4>
            <ul class="space-y-1 text-orange-600 dark:text-orange-400">
              <li>• Slower initial page load</li>
              <li>• Higher server resource usage</li>
              <li>• Requires server infrastructure</li>
              <li>• Less cache-friendly</li>
            </ul>
          </div>
        </div>
      </div>

      <!-- Navigation -->
      <div class="text-center">
        <a 
          href="/apps/router" 
          class="inline-flex items-center px-6 py-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors"
        >
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
          </svg>
          Back to Router Examples
        </a>
      </div>
    </div>
  </main>
</Layout>