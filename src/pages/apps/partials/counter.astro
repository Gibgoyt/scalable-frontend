---
export const partial = true;

let counter = 0;

if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData();
  const action = formData.get('action');
  const currentCount = parseInt(formData.get('currentCount') || '0');
  
  switch (action) {
    case 'increment':
      counter = currentCount + 1;
      break;
    case 'decrement':
      counter = currentCount - 1;
      break;
    case 'reset':
      counter = 0;
      break;
    default:
      counter = currentCount;
  }
} else {
  counter = 0;
}
---

<div class="text-center p-4 bg-blue-50 dark:bg-blue-900/20 border border-blue-200 dark:border-blue-700 rounded">
  <div class="text-4xl font-bold text-blue-800 dark:text-blue-200 mb-2">{counter}</div>
  <div class="text-sm text-blue-600 dark:text-blue-400 mb-3">Counter Value</div>
  <div class="text-xs text-blue-500 dark:text-blue-300">
    Server-rendered at: {new Date().toLocaleTimeString()}
  </div>
  
  <input type="hidden" name="currentCount" value={counter} />
</div>

<script>
  document.addEventListener('htmx:afterSwap', function(evt) {
    if (evt.target.id === 'counter-target') {
      const newCount = evt.target.querySelector('input[name="currentCount"]')?.value || '0';
      document.querySelectorAll('button[hx-target="#counter-target"]').forEach(btn => {
        const currentVals = btn.getAttribute('hx-vals');
        if (currentVals) {
          const vals = JSON.parse(currentVals);
          vals.currentCount = newCount;
          btn.setAttribute('hx-vals', JSON.stringify(vals));
        }
      });
    }
  });
</script>