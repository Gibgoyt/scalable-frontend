---
import Layout from 'src/layouts/Layout.astro';
---

<Layout title="Astro Partials + HTMX Demo">
  <main class="max-w-4xl mx-auto p-6">
    <!-- Back button -->
    <div class="mb-6">
      <a
        href="/apps"
        class="inline-flex items-center px-4 py-2 bg-gray-500 text-white rounded hover:bg-gray-600 transition-colors"
      >
        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
        </svg>
        Back to Apps
      </a>
    </div>

    <!-- Hero Section -->
    <section class="bg-gradient-to-r from-purple-600 to-blue-600 text-white rounded-lg p-8 mb-8">
      <h1 class="text-4xl font-bold mb-4">🚀 Astro Partials + HTMX Demo</h1>
      <p class="text-xl opacity-90">
        Explore the power of Astro's page partials combined with HTMX for dynamic, server-rendered content updates without full page reloads.
      </p>
    </section>

    <!-- Load HTMX -->
    <script src="https://unpkg.com/htmx.org@1.9.6" integrity="sha384-FhXw7b6AlE/jyjlZH5iHa/tTe9EpJ1Y55RjcgPbjeWMskSxZt1v9qkxLJWNJaGni" crossorigin="anonymous"></script>

    <!-- Demo Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
      <!-- Simple Click Demo -->
      <div class="bg-white dark:bg-gray-800 rounded-lg shadow-lg p-6">
        <h2 class="text-2xl font-bold mb-4 text-purple-600 dark:text-purple-400">Simple Click Demo</h2>
        <p class="text-gray-600 dark:text-gray-300 mb-4">
          Click the button below to load content from an Astro partial. The content is rendered on the server and injected into the page.
        </p>
        
        <div id="simple-target" class="mb-4 p-4 bg-gray-50 dark:bg-gray-700 rounded border-2 border-dashed border-gray-300 dark:border-gray-600 text-center text-gray-500 dark:text-gray-400">
          Click the button to load content here!
        </div>

        <button 
          hx-post="/apps/partials/simple-click"
          hx-trigger="click"
          hx-target="#simple-target"
          hx-swap="innerHTML"
          class="w-full px-4 py-2 bg-purple-600 text-white rounded hover:bg-purple-700 transition-colors"
        >
          Load Simple Content
        </button>
      </div>

      <!-- Counter Demo -->
      <div class="bg-white dark:bg-gray-800 rounded-lg shadow-lg p-6">
        <h2 class="text-2xl font-bold mb-4 text-blue-600 dark:text-blue-400">Interactive Counter</h2>
        <p class="text-gray-600 dark:text-gray-300 mb-4">
          A server-side counter that maintains state between requests. Each click increments the counter on the server.
        </p>
        
        <div id="counter-target" class="mb-4">
          <div class="text-center p-4 bg-gray-50 dark:bg-gray-700 rounded">
            <div class="text-3xl font-bold text-gray-800 dark:text-gray-200">0</div>
            <div class="text-sm text-gray-600 dark:text-gray-400">Counter Value</div>
          </div>
        </div>

        <div class="flex gap-2">
          <button 
            hx-post="/apps/partials/counter"
            hx-trigger="click"
            hx-target="#counter-target"
            hx-swap="innerHTML"
            hx-vals='{"action": "increment"}'
            class="flex-1 px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700 transition-colors"
          >
            Increment
          </button>
          <button 
            hx-post="/apps/partials/counter"
            hx-trigger="click"
            hx-target="#counter-target"
            hx-swap="innerHTML"
            hx-vals='{"action": "decrement"}'
            class="flex-1 px-4 py-2 bg-red-600 text-white rounded hover:bg-red-700 transition-colors"
          >
            Decrement
          </button>
          <button 
            hx-post="/apps/partials/counter"
            hx-trigger="click"
            hx-target="#counter-target"
            hx-swap="innerHTML"
            hx-vals='{"action": "reset"}'
            class="flex-1 px-4 py-2 bg-gray-600 text-white rounded hover:bg-gray-700 transition-colors"
          >
            Reset
          </button>
        </div>
      </div>

      <!-- Todo List Demo - Commented out until D1 database is integrated -->
      <!--
      <div class="bg-white dark:bg-gray-800 rounded-lg shadow-lg p-6">
        <h2 class="text-2xl font-bold mb-4 text-green-600 dark:text-green-400">Todo List</h2>
        <p class="text-gray-600 dark:text-gray-300 mb-4">
          Add and remove todos dynamically. Each action updates the server state and re-renders the list.
        </p>

        <div class="mb-4">
          <div class="flex gap-2">
            <input
              type="text"
              id="todo-input"
              placeholder="Enter a new todo..."
              class="flex-1 px-3 py-2 border border-gray-300 dark:border-gray-600 rounded focus:outline-none focus:ring-2 focus:ring-green-500 dark:bg-gray-700 dark:text-gray-100"
            />
            <button
              hx-post="/apps/partials/todos?action=add"
              hx-trigger="click"
              hx-target="#todos-target"
              hx-swap="innerHTML"
              hx-include="#todo-input"
              class="px-4 py-2 bg-green-600 text-white rounded hover:bg-green-700 transition-colors"
            >
              Add
            </button>
          </div>
        </div>

        <div id="todos-target"
             hx-get="/apps/partials/todos"
             hx-trigger="load"
             class="space-y-2">
        </div>
      </div>
      -->
      
      <!-- Placeholder for Todo List Demo -->
      <div class="bg-gray-100 dark:bg-gray-700 rounded-lg shadow-lg p-6 border-2 border-dashed border-gray-300 dark:border-gray-600">
        <h2 class="text-2xl font-bold mb-4 text-gray-500 dark:text-gray-400">Todo List Demo</h2>
        <p class="text-gray-500 dark:text-gray-400 mb-4">
          Coming soon! This demo will be available once D1 database integration is set up.
        </p>
        <div class="flex items-center space-x-2 text-sm text-gray-400 dark:text-gray-500">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
          </svg>
          <span>Requires database for persistent state management</span>
        </div>
      </div>

      <!-- Live Search Demo -->
      <div class="bg-white dark:bg-gray-800 rounded-lg shadow-lg p-6">
        <h2 class="text-2xl font-bold mb-4 text-orange-600 dark:text-orange-400">Live Search</h2>
        <p class="text-gray-600 dark:text-gray-300 mb-4">
          Search through a list of items with real-time server-side filtering. Results update as you type.
        </p>
        
        <div class="mb-4">
          <input 
            type="text" 
            name="search"
            placeholder="Search for programming languages..."
            hx-post="/apps/partials/search"
            hx-trigger="input changed delay:300ms"
            hx-target="#search-results"
            hx-swap="innerHTML"
            class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded focus:outline-none focus:ring-2 focus:ring-orange-500 dark:bg-gray-700 dark:text-gray-100"
          />
        </div>

        <div id="search-results" 
             hx-get="/apps/partials/search" 
             hx-trigger="load"
             class="space-y-2">
          <!-- Search results will be loaded here -->
        </div>
      </div>
    </div>

    <!-- Technical Details -->
    <section class="bg-gray-50 dark:bg-gray-800 rounded-lg p-6">
      <h2 class="text-2xl font-bold mb-4">How It Works</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div>
          <h3 class="text-lg font-semibold mb-2 text-purple-600 dark:text-purple-400">Astro Partials</h3>
          <ul class="space-y-2 text-sm text-gray-600 dark:text-gray-300">
            <li>• Page components that export <code class="bg-gray-200 dark:bg-gray-700 px-1 rounded">partial = true</code></li>
            <li>• Located in <code class="bg-gray-200 dark:bg-gray-700 px-1 rounded">src/pages/</code> directory</li>
            <li>• Render as HTML fragments without full page structure</li>
            <li>• Perfect for dynamic content updates</li>
          </ul>
        </div>
        <div>
          <h3 class="text-lg font-semibold mb-2 text-blue-600 dark:text-blue-400">HTMX Integration</h3>
          <ul class="space-y-2 text-sm text-gray-600 dark:text-gray-300">
            <li>• Declarative HTML attributes for AJAX requests</li>
            <li>• No JavaScript framework needed</li>
            <li>• Server-side rendering with client-side updates</li>
            <li>• Progressive enhancement approach</li>
          </ul>
        </div>
      </div>
    </section>
  </main>
</Layout>