---
export const partial = true;

const languages = [
  'JavaScript', 'TypeScript', 'Python', 'Java', 'C#', 'C++', 'Go', 'Rust', 
  'PHP', 'Ruby', 'Swift', 'Kotlin', 'Dart', 'Scala', 'Clojure', 'Haskell',
  'Elixir', 'F#', 'Lua', 'Perl', 'R', 'MATLAB', 'Julia', 'Objective-C'
];

let searchTerm = '';
let filteredLanguages = languages;

if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData();
  searchTerm = formData.get('search')?.toString() || '';
  
  if (searchTerm.trim()) {
    filteredLanguages = languages.filter(lang => 
      lang.toLowerCase().includes(searchTerm.toLowerCase())
    );
  }
}
---

<div class="space-y-2">
  {searchTerm && (
    <div class="text-sm text-orange-600 dark:text-orange-400 mb-2">
      {filteredLanguages.length > 0 
        ? `Found ${filteredLanguages.length} result${filteredLanguages.length === 1 ? '' : 's'} for "${searchTerm}"`
        : `No results found for "${searchTerm}"`
      }
    </div>
  )}
  
  {filteredLanguages.length === 0 ? (
    <div class="text-center py-8 text-gray-500 dark:text-gray-400">
      {searchTerm ? 'No programming languages match your search.' : 'Start typing to search...'}
    </div>
  ) : (
    <div class="grid grid-cols-2 gap-2">
      {filteredLanguages.map(language => (
        <div class="flex items-center space-x-2 p-2 bg-orange-50 dark:bg-orange-900/20 border border-orange-200 dark:border-orange-700 rounded">
          <svg class="w-4 h-4 text-orange-600 dark:text-orange-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path>
          </svg>
          <span class="text-orange-800 dark:text-orange-200 text-sm font-medium">{language}</span>
        </div>
      ))}
    </div>
  )}
  
  <div class="text-xs text-gray-500 dark:text-gray-400 text-center mt-4">
    Showing {filteredLanguages.length} of {languages.length} languages
  </div>
</div>