---
import Layout from 'src/layouts/Layout.astro';
import { Code } from 'astro/components';

// Server-side JavaScript runs at build time
const serverMessage = "This was generated on the server!";
const buildTime = new Date().toLocaleString();
const randomNumber = Math.floor(Math.random() * 100);

// Fetch some data (runs at build time)
const response = await fetch('https://api.github.com/repos/withastro/astro');
const repoData = await response.json();
---

<Layout title=".astro File Type Demo">
	<main>
		<!-- Hero Section -->
		<section class="bg-gradient-to-b from-orange-50 to-pink-50 dark:from-gray-900 dark:to-gray-800 py-16 lg:py-24">
			<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
				<div class="text-center">
					<div class="w-20 h-20 bg-gradient-to-br from-orange-400 to-pink-500 rounded-2xl flex items-center justify-center mx-auto mb-6">
						<svg class="w-10 h-10 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
						</svg>
					</div>
					<h1 class="text-4xl lg:text-5xl font-bold mb-6">.astro Component Demo</h1>
					<p class="text-xl text-gray-600 dark:text-gray-300 max-w-3xl mx-auto">
						Astro components combine HTML, CSS, JavaScript, and server-side code in a single file.
					</p>
				</div>
			</div>
		</section>

		<!-- Features Section -->
		<section class="py-16 lg:py-24">
			<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
				<h2 class="text-3xl font-bold text-center mb-12">Astro Component Features</h2>
				
				<!-- Server-Side JavaScript Demo -->
				<div class="mb-16">
					<h3 class="text-2xl font-bold mb-6">1. Server-Side JavaScript (Frontmatter)</h3>
					<div class="bg-white dark:bg-gray-800 rounded-xl shadow-lg p-8">
						<p class="text-gray-600 dark:text-gray-300 mb-4">
							The code between the <code class="bg-gray-100 dark:bg-gray-700 px-2 py-1 rounded">---</code> fences runs on the server at build time:
						</p>
						<div class="mb-4">
							<Code code={`---
const serverMessage = "This was generated on the server!";
const buildTime = new Date().toLocaleString();
const randomNumber = Math.floor(Math.random() * 100);
---`} lang="astro" />
						</div>
						<div class="bg-gray-50 dark:bg-gray-900 rounded-lg p-6">
							<p class="text-lg mb-2"><strong>Server Message:</strong> {serverMessage}</p>
							<p class="text-lg mb-2"><strong>Build Time:</strong> {buildTime}</p>
							<p class="text-lg"><strong>Random Number:</strong> {randomNumber}</p>
						</div>
					</div>
				</div>

				<!-- Component Composition -->
				<div class="mb-16">
					<h3 class="text-2xl font-bold mb-6">2. Component Composition</h3>
					<div class="bg-white dark:bg-gray-800 rounded-xl shadow-lg p-8">
						<p class="text-gray-600 dark:text-gray-300 mb-4">
							Import and use other components, layouts, and utilities:
						</p>
						<div class="mb-4">
							<Code code={`---
import Layout from 'src/layouts/Layout.astro';
import { Code } from 'astro/components';
---

<Layout title="My Page">
  <Code code="console.log('Hello!')" lang="js" />
</Layout>`} lang="astro" />
						</div>
					</div>
				</div>

				<!-- Data Fetching -->
				<div class="mb-16">
					<h3 class="text-2xl font-bold mb-6">3. Build-Time Data Fetching</h3>
					<div class="bg-white dark:bg-gray-800 rounded-xl shadow-lg p-8">
						<p class="text-gray-600 dark:text-gray-300 mb-4">
							Fetch data at build time using standard JavaScript APIs:
						</p>
						<div class="mb-4">
							<Code code={`---
const response = await fetch('https://api.github.com/repos/withastro/astro');
const repoData = await response.json();
---`} lang="astro" />
						</div>
						<div class="bg-gray-50 dark:bg-gray-900 rounded-lg p-6">
							<h4 class="font-bold mb-2">Astro Repository Stats:</h4>
							<p class="mb-1">⭐ Stars: {repoData.stargazers_count.toLocaleString()}</p>
							<p class="mb-1">🍴 Forks: {repoData.forks_count.toLocaleString()}</p>
							<p>👀 Watchers: {repoData.watchers_count.toLocaleString()}</p>
						</div>
					</div>
				</div>

				<!-- Scoped Styles -->
				<div class="mb-16">
					<h3 class="text-2xl font-bold mb-6">4. Scoped Styles</h3>
					<div class="bg-white dark:bg-gray-800 rounded-xl shadow-lg p-8">
						<p class="text-gray-600 dark:text-gray-300 mb-4">
							Styles defined in a <code class="bg-gray-100 dark:bg-gray-700 px-2 py-1 rounded">&lt;style&gt;</code> tag are automatically scoped:
						</p>
						<div class="mb-4">
							<Code code={`<style>
  .special-box {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
    padding: 2rem;
    border-radius: 1rem;
  }
</style>

<div class="special-box">
  This styling only applies to this component!
</div>`} lang="astro" />
						</div>
						<div class="special-box">
							This styling only applies to this component!
						</div>
					</div>
				</div>

				<!-- Client-Side JavaScript -->
				<div class="mb-16">
					<h3 class="text-2xl font-bold mb-6">5. Client-Side JavaScript</h3>
					<div class="bg-white dark:bg-gray-800 rounded-xl shadow-lg p-8">
						<p class="text-gray-600 dark:text-gray-300 mb-4">
							Add interactivity with <code class="bg-gray-100 dark:bg-gray-700 px-2 py-1 rounded">&lt;script&gt;</code> tags:
						</p>
						<div class="mb-4">
							<Code code={`<button id="clickMe">Click me!</button>
<p id="clickCount">Clicks: 0</p>

<script>
  let count = 0;
  const button = document.getElementById('clickMe');
  const display = document.getElementById('clickCount');
  
  button?.addEventListener('click', () => {
    count++;
    display.textContent = \`Clicks: \${count}\`;
  });
</script>`} lang="astro" />
						</div>
						<div class="bg-gray-50 dark:bg-gray-900 rounded-lg p-6">
							<button id="clickMe" class="px-6 py-3 bg-gradient-to-r from-orange-500 to-pink-500 text-white rounded-lg hover:from-orange-600 hover:to-pink-600 transition-colors font-medium mb-4">
								Click me!
							</button>
							<p id="clickCount" class="text-lg font-medium">Clicks: 0</p>
						</div>
					</div>
				</div>

				<!-- Template Directives -->
				<div class="mb-16">
					<h3 class="text-2xl font-bold mb-6">6. Template Directives</h3>
					<div class="bg-white dark:bg-gray-800 rounded-xl shadow-lg p-8">
						<p class="text-gray-600 dark:text-gray-300 mb-4">
							Use JavaScript expressions and control flow in templates:
						</p>
						<div class="mb-4">
							<Code code={`---
const items = ['Astro', 'Vite', 'TypeScript', 'Tailwind'];
const showList = true;
---

{showList && (
  <ul>
    {items.map((item) => (
      <li>{item}</li>
    ))}
  </ul>
)}`} lang="astro" />
						</div>
						<div class="bg-gray-50 dark:bg-gray-900 rounded-lg p-6">
							<h4 class="font-bold mb-2">Tech Stack:</h4>
							<ul class="list-disc list-inside">
								{['Astro', 'Vite', 'TypeScript', 'Tailwind'].map((item) => (
									<li>{item}</li>
								))}
							</ul>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Back Link -->
		<section class="py-16 bg-gray-50 dark:bg-gray-900">
			<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
				<a href="/apps" class="inline-flex items-center px-6 py-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors">
					<svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
					</svg>
					Back to Applications Hub
				</a>
			</div>
		</section>
	</main>
</Layout>

<style>
	.special-box {
		background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
		color: white;
		padding: 2rem;
		border-radius: 1rem;
		text-align: center;
		font-size: 1.125rem;
		font-weight: 500;
	}
</style>

<script>
	let count = 0;
	const button = document.getElementById('clickMe');
	const display = document.getElementById('clickCount');
	
	button?.addEventListener('click', () => {
		count++;
		if (display) {
			display.textContent = `Clicks: ${count}`;
		}
	});
</script>